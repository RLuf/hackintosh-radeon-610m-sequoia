+		LOG("4a: framebuffer stubs kept (-rmbfbstubs); 6 write-dropping register hooks %s; enableController will be refused",
+		    s2WritesBlocked ? "installed" : "MISSING: controller start will be declined");
+		if (s2WritesBlocked)
+			displayStage4aOpen(patcher, index, address, size);
+	}
 	if (gHeadless) {
 		KernelPatcher::RouteRequest fbReq {"__ZN35AMDRadeonX6000_AmdRadeonFramebuffer5startEP9IOService", wrapFbStart};
 		KernelPatcher::RouteRequest stubReq {"__ZN34AMDRadeonX6000_AmdRadeonController13createFbStubsEh", wrapCreateFbStubsZero, orgCreateFbStubs};
@@ -514,7 +532,8 @@ static void processFramebuffer(KernelPatcher &patcher, size_t index, mach_vm_add
 		{"__ZN34AMDRadeonX6000_AmdRadeonController5startEP9IOService", s2 && !gFbStagedOk ? wrapCtrlStartDeclined : wrap_CtrlStart, org_CtrlStart},
 		{"__ZN34AMDRadeonX6000_AmdRadeonController19initializeInternalsEP9IOService", wrap_CtrlInitInternals, org_CtrlInitInternals},
 		{"__ZN34AMDRadeonX6000_AmdRadeonController7powerUpEv", wrap_CtrlPowerUp, org_CtrlPowerUp},
-		{"__ZN35AMDRadeonX6000_AmdRadeonFramebuffer16enableControllerEv", wrap_FbEnableController, org_FbEnableController},
+		{"__ZN35AMDRadeonX6000_AmdRadeonFramebuffer16enableControllerEv",
+		 fbStubs && !gHeadless ? wrapFbEnableControllerRefused : wrap_FbEnableController, org_FbEnableController},
 		{"__ZN40AMDRadeonX6000_AmdRadeonControllerNavi2328createControllerCoreServicesEv", wrap_CreateCoreServices, org_CreateCoreServices},
 		{"__ZN29AMDRadeonX6000_AmdGpuWrangler5startEP9IOService", wrap_WranglerStart, org_WranglerStart},
 		{"__ZN31AMDRadeonX6000_AmdAsicInfoNavi218populateDeviceInfoEv", wrapPopulateDeviceInfo, orgPopulateDeviceInfo},
@@ -987,12 +1006,13 @@ static uint64_t stage3_ttl_hw_init(uint64_t a, uint64_t b, uint64_t c, uint64_t
 	}
 	gStage3Armed = true;
 	LOG("stage 3: preflight passed, hardware init allowed");
-	LOG("stage 3: kext patch 0022, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s",
+	LOG("stage 3: kext patch 0023, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s; framebuffers %s",
 	    checkKernelArgument("-rmbacceptrlc") ? "ON (-rmbacceptrlc)" : "off",
 	    checkKernelArgument("-rmbsendasd") ? "sent (-rmbsendasd)" : "not sent",
 	    checkKernelArgument("-rmbcamcheck") ? "Apple's (-rmbcamcheck)" : "skipped",
 	    checkKernelArgument("-rmbgpuclean") ? "by GPU DMA (-rmbgpuclean)" : "by CPU",
-	    checkKernelArgument("-rmbutcl2harvest") ? "programmed (-rmbutcl2harvest)" : "not programmed");
+	    checkKernelArgument("-rmbutcl2harvest") ? "programmed (-rmbutcl2harvest)" : "not programmed",
+	    checkKernelArgument("-rmbfbstubs") ? "stubs kept, enableController refused (-rmbfbstubs, 4a)" : "none (headless)");
 	smuStage3BeforeHwInit();
 	s3Sample("before ttl_hw_init");
