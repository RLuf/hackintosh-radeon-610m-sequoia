+// Sub-stage 4a (rmbstage=3 plus -rmbfbstubs), patch 0023. Measured at the boot of 24/11 19:33: the
+// accelerator exists but every Metal allocation sleeps in IOGraphicsAccelerator2::
+// acceleratorWaitEnabled(). The enabled bit ([accel+0xc78] & 2, IOAcceleratorFamily2 of 15.8.1) is
+// set only by enableAccelerator(), whose only callers are IOAccel(Legacy)DisplayMachine::
+// display_mode_did_change(), and that notification comes from IOFramebuffer::open(): it delivers
+// WillChange, calls enableController and delivers DidChange even when enableController fails.
+// So: Apple's framebuffer stubs are published (kern_start.cpp), enableController is refused (the
+// DAL never runs, the DCN and the DMCUB stay as the BIOS left them, register writes still dropped)
+// and this thread opens framebuffer 0 once the accelerator is up. -rmbnoopen: no open by the kext.
+static void stage4aOpen(void *, wait_result_t) {
+	constexpr uint64_t Timeout = 120ULL * 1000 * 1000 * 1000;
+	constexpr uint32_t DcnSeg2 = 0x34C0;
+	auto accelFlags = [](IOService *accel) { return *reinterpret_cast<const volatile uint32_t *>(reinterpret_cast<const uint8_t *>(accel) + 0xc78); };
+	auto accelVram = [](IOService *accel) { return *reinterpret_cast<const volatile uint64_t *>(reinterpret_cast<const uint8_t *>(accel) + 0x180); };
+	auto matching = IOService::serviceMatching("AMDRadeonX6000_AMDNavi23GraphicsAccelerator");
+	auto accel = matching ? IOService::waitForMatchingService(matching, Timeout) : nullptr;
+	OSSafeReleaseNULL(matching);
+	if (!accel) {
+		LOG("4a: no accelerator within 120 s, framebuffer not opened");
+		return;
+	}
+	IOSleep(1000);
+	// Read-only picture of what the BIOS left running (the DMCUB that drives the panel).
+	if (mmioAvailable())
+		LOG("4a: before open: DMCUB_CNTL %x CNTL2 %x SCRATCH0 %x SCRATCH14 %x; accel flags %x (enabled %d) vram desc %s",
+		    mmioRead(DcnSeg2 + 0x1f6), mmioRead(DcnSeg2 + 0x200), mmioRead(DcnSeg2 + 0x1e3), mmioRead(DcnSeg2 + 0x1f1),
+		    accelFlags(accel), (accelFlags(accel) >> 1) & 1, accelVram(accel) ? "set" : "null");
+	IOService *fb0 = nullptr;
+	unsigned count = 0;
+	matching = IOService::serviceMatching("AMDRadeonX6000_AmdRadeonFramebuffer");
+	auto iter = matching ? IOService::getMatchingServices(matching) : nullptr;
+	OSSafeReleaseNULL(matching);
+	while (auto svc = iter ? OSDynamicCast(IOService, iter->getNextObject()) : nullptr) {
+		count++;
+		auto loc = svc->getLocation();
+		if (!fb0 && loc && !strcmp(loc, "0")) {
+			fb0 = svc;
+			fb0->retain();
+		}
+	}
+	OSSafeReleaseNULL(iter);
+	LOG("4a: %u AmdRadeonFramebuffer services, framebuffer 0 %s", count, fb0 ? "found" : "NOT found");
+	if (fb0 && !checkKernelArgument("-rmbnoopen")) {
+		auto vt = *reinterpret_cast<mach_vm_address_t **>(fb0);
+		size_t slot = 0;
+		for (size_t i = FbOpenSlotMin; gFbOpen && i <= FbOpenSlotMax && !slot; i++)
+			if (vt[i] == gFbOpen)
+				slot = i;
+		if (!slot) {
+			LOG("4a: framebuffer open %llx not in vtable slots %zu-%zu, not opening", gFbOpen, FbOpenSlotMin, FbOpenSlotMax);
+		} else {
+			LOG("4a: opening framebuffer 0 (vtable slot %zu)", slot);
+			auto r = reinterpret_cast<IOReturn (*)(IOService *)>(vt[slot])(fb0);
+			LOG("4a: framebuffer 0 open = %x (an error is expected: enableController is refused)", r);
+		}
+	}
+	IOSleep(500);
+	LOG("4a: after open: accel flags %x (enabled %d) vram desc %s; DMCUB_CNTL %x CNTL2 %x SCRATCH0 %x", accelFlags(accel),
+	    (accelFlags(accel) >> 1) & 1, accelVram(accel) ? "set" : "null", mmioAvailable() ? mmioRead(DcnSeg2 + 0x1f6) : 0,
+	    mmioAvailable() ? mmioRead(DcnSeg2 + 0x200) : 0, mmioAvailable() ? mmioRead(DcnSeg2 + 0x1e3) : 0);
+	OSSafeReleaseNULL(fb0);
+	accel->release();
+}
+
+void displayStage4aOpen(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+	gFbOpen = patcher.solveSymbol(index, "__ZN35AMDRadeonX6000_AmdRadeonFramebuffer4openEv", address, size);
+	patcher.clearError();
+	if (!gFbOpen)
+		LOG("4a: AmdRadeonFramebuffer::open not found: the kext will not open framebuffer 0");
+	thread_t t;
+	if (kernel_thread_start(stage4aOpen, nullptr, &t) == KERN_SUCCESS)
+		thread_deallocate(t);
+}
