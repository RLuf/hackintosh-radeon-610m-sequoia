 	LOG("stage %u: AmdRadeonController start declined (headless or register hooks missing)", rmbStage());
@@ -493,7 +500,18 @@ static void processFramebuffer(KernelPatcher &patcher, size_t index, mach_vm_add
 			ihMmioWptr(patcher, address, size);
 		s2WritesBlocked = displayRouteStage2(patcher, index, address, size);
 	}
-	gHeadless = s2 || checkKernelArgument("-rmbheadless");
+	// Sub-stage 4a (patch 0023): stage 3 plus -rmbfbstubs keeps Apple's framebuffer stubs, so that
+	// the accelerator gets its display-mode notification and becomes enabled. Register writes stay
