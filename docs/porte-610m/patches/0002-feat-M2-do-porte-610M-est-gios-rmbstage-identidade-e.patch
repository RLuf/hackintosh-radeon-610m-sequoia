+// Stage 2: only the register access hooks, and they drop every write (stage2Dropped). No watchdog
+// or poller thread, no early open, no backlight or presenter hook. Write hooks first; false unless
+// all six are in place, and then the caller must not let the controller start.
+bool displayRouteStage2(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+	KernelPatcher::RouteRequest reqs[] {
+		{"__ZN27AMDRadeonX6000_AmdDalHelper22dalAtomWriteRegister32EPvjj", wrapWrite, orgWrite},
+		{"__ZN32AMDRadeonX6000_AmdRegisterAccess10writeReg32Ejj", wrapRawWrite, orgRawWrite},
+		{"__ZN27AMDRadeonX6000_AmdDalHelper19dalAtomExecCmdTableEPvjS0_", wrapExecTable, orgExecTable},
+		{"__ZN27AMDRadeonX6000_AmdDalHelper21dalAtomReadRegister32EPvj", wrapRead, orgRead},
+		{"__ZN32AMDRadeonX6000_AmdRegisterAccess11hwReadReg32Ej", wrapRawRead<orgHwRead>, orgHwRead},
+		{"__ZN32AMDRadeonX6000_AmdRegisterAccess17readValidateReg32Ej", wrapRawRead<orgValRead>, orgValRead},
+	};
+	gFbText = address;
+	size_t routed = 0;
+	for (auto &r : reqs) {
+		if (patcher.routeMultiple(index, &r, 1, address, size))
+			routed++;
+		else
+			LOG("stage 2: failed to route %s (err %d)", r.symbol, static_cast<int>(patcher.getError()));
+		patcher.clearError();
+	}
+	LOG("stage 2: %zu of %zu framebuffer register hooks installed; writes and ATOM tables are dropped", routed, arrsize(reqs));
+	return routed == arrsize(reqs);
+}
