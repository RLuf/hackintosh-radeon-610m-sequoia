+// Bring-up stage of the 610M port (see rmb.hpp). 0 = full driver as upstream, only with -rmbnoprobe
+// and without -rmbprobe (-rmbprobe wins if both are given). Otherwise rmbstage=N: 1 (default, and
+// the fallback for any other value) or 2.
+uint32_t rmbStage() {
+	static int stage = -1;
+	if (stage < 0) {
+		uint32_t n = 1;
+		if (!checkKernelArgument("-rmbprobe") && checkKernelArgument("-rmbnoprobe"))
+			n = 0;
+		else if (!lilu_get_boot_args("rmbstage", &n, sizeof(n)) || n != 2)
+			n = 1;
+		stage = static_cast<int>(n);
+	}
+	return static_cast<uint32_t>(stage);
 }
 
+bool rmbProbe() { return rmbStage() != 0; }
