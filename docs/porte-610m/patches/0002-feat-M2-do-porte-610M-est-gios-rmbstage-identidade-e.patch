+// AmdRegisterAccess writes and VBIOS command tables are dropped and counted here.
+bool stage2Dropped(const char *what, uint32_t a, uint32_t b) {
+	if (rmbStage() != 2)
+		return false;
+	static uint32_t n;
+	if (n++ < 40 || n % 1000 == 0)
+		LOG("stage 2: dropped %s %x = %x (#%u)", what, a, b, n);
