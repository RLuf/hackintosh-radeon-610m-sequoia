 	}
 	gStage3Armed = true;
 	LOG("stage 3: preflight passed, hardware init allowed");
-	LOG("stage 3: kext patch 0039, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s; framebuffers %s; accelerator message 6 %s",
+	LOG("stage 3: kext patch 0040, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s; framebuffers %s; accelerator message 6 %s",
 	    checkKernelArgument("-rmbacceptrlc") ? "ON (-rmbacceptrlc)" : "off",
 	    checkKernelArgument("-rmbsendasd") ? "sent (-rmbsendasd)" : "not sent",
 	    checkKernelArgument("-rmbcamcheck") ? "Apple's (-rmbcamcheck)" : "skipped",
diff --git a/src/RembrandtGfx/mmio.cpp b/src/RembrandtGfx/mmio.cpp
index 0d42580..5f9bac8 100644
--- a/src/RembrandtGfx/mmio.cpp
+++ b/src/RembrandtGfx/mmio.cpp
@@ -78,7 +78,7 @@ static bool stage3MayWrite(uint32_t reg) {
 // dcn_3_1_6_offset.h), written by gopfb's 'amtr' flip. Nothing else of the DCN.
 bool gGopFlipWrites;
 static bool gopFlipMayWrite(uint32_t reg) {
-	return gGopFlipWrites && rmbStage() == 3 && rmbStage3Armed() && (reg == 0x3aca || reg == 0x3acb);
+	return gGopFlipWrites && rmbStage() == 3 && rmbStage3Armed() && (reg == 0x3aca || reg == 0x3acb || reg == 0x3aa6 || reg == 0x3aa7);  // + HUBP0 ADDR/TILING_CONFIG (0040)
 }
 
 void mmioWrite(uint32_t reg, uint32_t value) {
