diff --git a/src/RembrandtGfx/mmio.cpp b/src/RembrandtGfx/mmio.cpp
index 9308831..0d42580 100644
--- a/src/RembrandtGfx/mmio.cpp
+++ b/src/RembrandtGfx/mmio.cpp
@@ -74,8 +74,15 @@ static bool stage3MayWrite(uint32_t reg) {
 	        reg == 0x16000 + 0x282 || reg == 0x16000 + 0x292 || reg == 0x16000 + 0x29a);
 }
 
+// Patch 0038 (-rmbgopflip): HUBP0 DCSURF_PRIMARY_SURFACE_ADDRESS / _HIGH (0x34C0 + 0x60a / 0x60b,
+// dcn_3_1_6_offset.h), written by gopfb's 'amtr' flip. Nothing else of the DCN.
+bool gGopFlipWrites;
+static bool gopFlipMayWrite(uint32_t reg) {
+	return gGopFlipWrites && rmbStage() == 3 && rmbStage3Armed() && (reg == 0x3aca || reg == 0x3acb);
+}
+
 void mmioWrite(uint32_t reg, uint32_t value) {
-	if (rmbProbe() && !stage2MayWrite(reg, value) && !stage3MayWrite(reg)) {  // stages 1-3: only what the stage lists
+	if (rmbProbe() && !stage2MayWrite(reg, value) && !stage3MayWrite(reg) && !gopFlipMayWrite(reg)) {  // stages 1-3: only what the stage lists
 		static uint32_t dropped;
 		if (dropped++ < 40)
 			LOG("mmio: stage %u dropped write %x = %x (#%u)", rmbStage(), reg, value, dropped);
