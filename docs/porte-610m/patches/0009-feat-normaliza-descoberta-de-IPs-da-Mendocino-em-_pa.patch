 bool gFwHooksOk;     // the PSP hooks of this stage are in place
 size_t gFwSubsDone;  // GC descriptors pointed at the embedded images (11 = all)
+bool gSdmaSubDone;   // SDMA descriptor pointed at the embedded image
 
 }  // namespace
 
@@ -222,10 +223,10 @@ size_t gFwSubsDone;  // GC descriptors pointed at the embedded images (11 = all)
 bool firmwareReady(const char *set) {
 	size_t n = strlen(set);
 	bool right = !strncmp(fw_apu_manifest, "set=", 4) && !strncmp(fw_apu_manifest + 4, set, n) && fw_apu_manifest[4 + n] == ' ';
