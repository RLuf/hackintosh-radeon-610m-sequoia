+// Called by disklog.cpp once, right after its file is open. Prints the saved lines again with a "replay:"
+// mark, so the disk log has the whole probe even when the boot msgbuf dropped its first lines.
+void ipDiscReplay() {
+	if (!gSavedLen)
+		return;
+	printf("RembrandtGfx: probe: replay of the %u bytes of probe lines follows\n", gSavedLen);
+	for (uint32_t i = 0, start = 0; i < gSavedLen; i++) {
+		if (gSaved[i] != '\n')
+			continue;
+		gSaved[i] = 0;
+		printf("RembrandtGfx: replay: %s\n", gSaved + start);
+		gSaved[i] = '\n';
+		start = i + 1;
+	}
+	printf("RembrandtGfx: probe: replay end\n");
+}
