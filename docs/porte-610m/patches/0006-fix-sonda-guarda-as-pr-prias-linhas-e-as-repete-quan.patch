+// 82X5, 15.8.1, 2026-11-22: only the last 14 of the ~45 probe lines reached the disk. They are printed in
+// the first second, the boot msgbuf is still the small one, and disklog.cpp opens its file seconds later.
+// Every probe line is therefore also kept here, and ipDiscReplay() prints them again once the file is open.
+char gSaved[12288];
+uint32_t gSavedLen;
+void plog(const char *fmt, ...) __printflike(1, 2);
+void plog(const char *fmt, ...) {
+	char line[400];
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	printf("RembrandtGfx: %s\n", line);
+	size_t n = strlen(line);
+	if (gSavedLen + n + 1 <= sizeof(gSaved)) {
+		memcpy(gSaved + gSavedLen, line, n);
+		gSavedLen += static_cast<uint32_t>(n);
+		gSaved[gSavedLen++] = '\n';
+	}
+}
