From 7616e0f1ef1196e2859b7d2645a25da3873e8268 Mon Sep 17 00:00:00 2001
From: fzmac <noreply@example.invalid>
Date: Thu, 26 Nov 2026 21:55:53 -0300
Subject: [PATCH 44/48] -rmbgopflip le o flip+8 a cada tique e reaponta o HUBP0
 quando muda, como o hubpPoll do Radeonized (0038c)

Co-authored-by: opus-fable
---
 src/RembrandtGfx/display.cpp    | 48 ++++++++++++++++++++++-----------
 src/RembrandtGfx/kern_start.cpp |  2 +-
 2 files changed, 33 insertions(+), 17 deletions(-)

diff --git a/src/RembrandtGfx/display.cpp b/src/RembrandtGfx/display.cpp
index d0bcd85..859135c 100644
--- a/src/RembrandtGfx/display.cpp
+++ b/src/RembrandtGfx/display.cpp
@@ -3447,13 +3447,40 @@ volatile uint32_t gTicks;
 // only 256-byte aligned. HIGH then LOW, as Linux (dcn20_hubp.c: "program high first and then the
 // low addr, order matters!"). Counted here, logged by the tick thread.
 bool gFlipOn;
-volatile SInt32 gFlipOk, gFlipBad;
+volatile SInt32 gFlipOk, gFlipBad, gFlipPolled;
 volatile uint64_t gFlipLast, gFlipLastMc;
+// Patch 0038c: the compositor rotates its swap chain without a new 'amtr' (Radeonized 2x3: three
+// surfaces, one transaction every ~6 s), and Apple keeps rewriting the same _AMD_PIPE_FLIP in place
+// (pipe+0x36b0, owned by the AMDAccelDisplayPipe kernel object, which lives as long as the
+// accelerator). So the flip+8 pointer from the first accepted 'amtr' is re-read on every tick (one
+// per frame) and HUBP0 reprogrammed when it changes, as Radeonized's hubpPoll does on vblank.
+volatile uint64_t gFlipPtr;
+void gopFlipProgram(uint64_t a) {
+	constexpr uint64_t Vram = 0x80000000ULL;  // 2 GB carve-out
+	uint64_t need = static_cast<uint64_t>(gMode.rowBytes) * gMode.h, base = gMode.fbBaseMc, mc = 0;
+	if (base && a >= base && a + need <= base + Vram)
+		mc = a;
+	gFlipLast = a;
+	if (mc && !(mc & 0xff)) {
+		mmioWrite(0x3acb, static_cast<uint32_t>(mc >> 32) & 0xffff);
+		mmioWrite(0x3aca, static_cast<uint32_t>(mc));
+		gFlipLastMc = mc;
+		OSIncrementAtomic(&gFlipOk);
+	} else
+		OSIncrementAtomic(&gFlipBad);
+}
 
 void tickThread(void *, wait_result_t) {
 	for (;;) {
 		IOSleep(gMode.hz ? 1000 / gMode.hz : 16);
 		gTicks++;
+		if (gFlipOn && gFlipPtr && gMode.ok) {
+			uint64_t a = *reinterpret_cast<const volatile uint64_t *>(gFlipPtr);
+			if (a && a != gFlipLast) {
+				OSIncrementAtomic(&gFlipPolled);
+				gopFlipProgram(a);
+			}
+		}
 		uint32_t pend[4];
 		for (int i = 0; i < 4; i++)
 			pend[i] = gTxnPending[i] && OSCompareAndSwap(1, 0, &gTxnPending[i]);
@@ -3477,8 +3504,8 @@ void tickThread(void *, wait_result_t) {
 			    x.flip[12], x.flip[13], x.flip[14], x.flip[15]);
 		}
 		if (gTicks == 600 || gTicks % 36000 == 0)
-			LOG("gopfb: tick %u, amtr transactions seen %u; flips written %d rejected %d, last surface %llx -> mc %llx", gTicks,
-			    gTxnSeen, gFlipOk, gFlipBad, gFlipLast, gFlipLastMc);
+			LOG("gopfb: tick %u, amtr transactions seen %u; flips written %d rejected %d (%d by polling), last surface %llx -> mc %llx", gTicks,
+			    gTxnSeen, gFlipOk, gFlipBad, gFlipPolled, gFlipLast, gFlipLastMc);
 	}
 }
 
@@ -3774,19 +3801,8 @@ IOReturn setAttribute(void *fb, IOSelect sel, uintptr_t value) {
 			snap.ready = true;
 		}
 		if (gFlipOn && i == 0 && gMode.ok && gMode.fbBaseMc && (t[0] & 1) && t[2] >= 0xffffff8000000000ULL) {
-			uint64_t a = *reinterpret_cast<const uint64_t *>(t[2] + 8);
-			constexpr uint64_t Vram = 0x80000000ULL;  // 2 GB carve-out
-			uint64_t need = static_cast<uint64_t>(gMode.rowBytes) * gMode.h, base = gMode.fbBaseMc, mc = 0;
-			if (a >= base && a + need <= base + Vram)
-				mc = a;
-			gFlipLast = a;
-			if (mc && !(mc & 0xff)) {
-				mmioWrite(0x3acb, static_cast<uint32_t>(mc >> 32) & 0xffff);
-				mmioWrite(0x3aca, static_cast<uint32_t>(mc));
-				gFlipLastMc = mc;
-				OSIncrementAtomic(&gFlipOk);
-			} else
-				OSIncrementAtomic(&gFlipBad);
+			gFlipPtr = t[2] + 8;
+			gopFlipProgram(*reinterpret_cast<const uint64_t *>(t[2] + 8));
 		}
 		if (i >= 0 && i < 4)
 			gTxnPending[i] = 1;  // retired by the next tick ('txni')
diff --git a/src/RembrandtGfx/kern_start.cpp b/src/RembrandtGfx/kern_start.cpp
index 57fc120..9f7002b 100644
--- a/src/RembrandtGfx/kern_start.cpp
+++ b/src/RembrandtGfx/kern_start.cpp
@@ -1317,7 +1317,7 @@ static uint64_t stage3_ttl_hw_init(uint64_t a, uint64_t b, uint64_t c, uint64_t
 	}
 	gStage3Armed = true;
 	LOG("stage 3: preflight passed, hardware init allowed");
-	LOG("stage 3: kext patch 0038b, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s; framebuffers %s; accelerator message 6 %s",
+	LOG("stage 3: kext patch 0038c, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s; framebuffers %s; accelerator message 6 %s",
 	    checkKernelArgument("-rmbacceptrlc") ? "ON (-rmbacceptrlc)" : "off",
 	    checkKernelArgument("-rmbsendasd") ? "sent (-rmbsendasd)" : "not sent",
 	    checkKernelArgument("-rmbcamcheck") ? "Apple's (-rmbcamcheck)" : "skipped",
