+// Patch 0025. Apple's interrupt library (AmdInterruptManager::startInterrupts and what the
+// accelerator asks of it afterwards) writes its registers through AmdRegisterAccess::writeReg32,
+// i.e. through this hook, which stages 2 and 3 turn into a drop. Once the rmb-irq thread sets the
+// mode, the interrupt ring (OSSSYS 5.2.1, base 0x10A0) and GC / SDMA0 (source enables) go to the
+// chip untouched; everything else (NBIO, HDP, the whole display engine) is still dropped. Every
+// write is logged, passed or not, so the next step knows exactly what the library wanted.
+// (the three counters are defined in kern_start.cpp: this file is one anonymous namespace)
+static bool irqPassReg(uint32_t r) {
+	return (r >= 0x10A0 && r < 0x1260)     // OSSSYS 5.2.1 (IH), discovery hw_id 40
+	    || (r >= 0x1260 && r < 0x34C0)     // GC 10.3.7 / SDMA0 5.2.7, segment 0
+	    || (r >= 0xA000 && r < 0x10000);   // GC / SDMA0, segment 1
+}
+
 uint64_t wrapRawWrite(uint64_t self, uint64_t reg, uint64_t val) {
 	uint32_t r = reg & 0xFFFFFFFF;
+	if (uint32_t mode = gIrqWriteMode; mode && rmbStage() == 3) {
+		bool pass = mode == 1 && irqPassReg(r);
+		uint32_t n = pass ? ++gIrqWritePassed : ++gIrqWriteDropped;
+		if (gIrqWritePassed + gIrqWriteDropped <= 600 || n % 5000 == 0)
+			LOG("irq: %s raw write %x = %x (caller +%x, #%u)", pass ? "pass" : "drop", r, static_cast<uint32_t>(val),
+			    callerOff(__builtin_return_address(0)), n);
+		if (pass)
+			return reinterpret_cast<uint64_t (*)(uint64_t, uint64_t, uint64_t)>(orgRawWrite)(self, reg, val);
+		return 0;
+	}
 	if (stage2Dropped("raw write", r, val & 0xFFFFFFFF))  // every register, display or not
 		return 0;
 	eoi0Note(r, val & 0xFFFFFFFF);
