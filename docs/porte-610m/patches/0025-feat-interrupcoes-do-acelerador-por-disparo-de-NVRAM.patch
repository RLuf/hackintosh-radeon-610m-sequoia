+}
+static uint64_t gIrqMgr;
+static bool irqStart(uint64_t ctrl, bool dry) {
+	auto vt = [](uint64_t o, uint32_t slot) { return (*reinterpret_cast<uint64_t **>(o))[slot / 8]; };
+	uint64_t im = *reinterpret_cast<uint64_t *>(ctrl + 0x7978), src = *reinterpret_cast<uint64_t *>(ctrl + 0xc0);
+	uint64_t wl = src ? reinterpret_cast<uint64_t (*)(uint64_t)>(vt(src, 0x688))(src) : 0;
+	if (!im || !wl) {
+		LOG("irq: no interrupt manager (%s) or work loop (%s): not started", im ? "set" : "NULL", wl ? "set" : "NULL");
+		return false;
+	}
+	gIrqMgr = im;
+	accelState4a(ctrl, "irq", "before");
+	ihSnap("before");
+	LOG("irq: calling AmdInterruptManager::startInterrupts, register writes %s; manager flags %x, controller flags %x",
+	    dry ? "all DROPPED and logged (rmb-irq=d)" : "to OSSSYS and GC/SDMA0 PASS, the rest dropped", *reinterpret_cast<uint8_t *>(im + 0x78),
+	    *reinterpret_cast<uint8_t *>(ctrl + 0x5f18));
+	gIrqWriteMode = dry ? 2 : 1;
+	auto r = reinterpret_cast<uint64_t (*)(uint64_t, uint64_t)>(vt(im, 0x120))(im, wl);
+	*reinterpret_cast<volatile uint8_t *>(ctrl + 0x5f18) |= 1;  // c01979a
+	LOG("irq: startInterrupts = %llx; manager flags %x, MSI source index %d, controller flags %x", r & 0xFFFFFFFF,
+	    *reinterpret_cast<uint8_t *>(im + 0x78), *reinterpret_cast<int32_t *>(im + 0x58), *reinterpret_cast<uint8_t *>(ctrl + 0x5f18));
+	IOSleep(200);
+	ihSnap("after");
+	return !(r & 0xFFFFFFFF);
+}
+// One step of the watchdog, every 100 ms: true once the ring had to be stopped.
+static bool irqWatch() {
+	static uint32_t lastCalls, lastEntries, quiet;
+	static bool stopped;
+	if (stopped || !gIrqMgr)
+		return stopped;
+	uint32_t c, e, st;
+	ihFlushStats(c, e, st);
+	uint32_t dc = c - lastCalls, de = e - lastEntries, wptr = mmioRead(0x1124);
+	lastCalls = c, lastEntries = e;
+	bool storm = dc > 2000 || de > 20000, overflow = wptr != 0xFFFFFFFF && (wptr & 1);
+	if (storm || overflow) {
+		stopped = true;
+		LOG("irq: WATCHDOG: %s (in 100 ms: %u get-wptr calls, %u entries; wptr %x): stopping the ring", storm ? "storm" : "ring overflow", dc, de, wptr);
+		ihStopNow(storm ? "storm" : "overflow");
+		auto pci = *reinterpret_cast<IOService **>(gIrqMgr + 0x30);
+		int idx = *reinterpret_cast<int32_t *>(gIrqMgr + 0x58);
+		if (pci && idx >= 0)
+			LOG("irq: WATCHDOG: disableInterrupt(%d) = %x", idx, pci->disableInterrupt(idx));
+		ihSnap("stopped");
+	} else if (++quiet % 600 == 0) {
+		ihSnap("alive");  // once a minute
+	}
+	return stopped;
+}
