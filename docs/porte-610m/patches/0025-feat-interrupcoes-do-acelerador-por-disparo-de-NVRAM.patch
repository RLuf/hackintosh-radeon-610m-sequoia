+// Patch 0025: emergency stop for the interrupt ring, used only by the rmb-irq watchdog
+// (kern_start.cpp) when the ring storms or overflows right after Apple's startInterrupts. Same
+// writes as quiesceIh / Linux navi10_ih_disable_interrupts, without the stage guard: this is the
+// one OSSSYS write the kext itself makes in stage 3, and only to turn the ring off.
+void ihStopNow(const char *why) {
+	static constexpr uint32_t Base = 0x10A0;
+	static constexpr uint32_t cntls[] {0x80, 0x8c, 0x98};
+	if (!mapMmio())
+		return;
+	for (size_t i = 0; i < arrsize(cntls); i++) {
+		uint32_t before = gMmio[Base + cntls[i]];
+		gMmio[Base + cntls[i]] = before & ~((i == 0 ? 1U << 17 : 0U) | 1U);  // ENABLE_INTR (ring 0), RB_ENABLE
+		LOG("irq: STOP (%s): ring %zu cntl %08x -> %08x", why, i, before, gMmio[Base + cntls[i]]);
+	}
+}
