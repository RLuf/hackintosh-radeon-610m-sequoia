-	if (off + 8 > gVram->getLength())
+	if (off + 8 > gVram->getLength() && gCarveRead && rmbProbe()) {
+		if (!carveRead64Locked(off, v))
+			v = ~0ULL;
+	} else if (off + 8 > gVram->getLength())
 		v = vramReadIndirect32(off) | (uint64_t)vramReadIndirect32(off + 4) << 32;
 	else {
 		auto p = vramPtr(off);
