+// Patch 0033 (-rmbhdpwatch), measurement only. AMDGFX10HWMemory::programOrClearHDPRegisters(win,
+// bar, vramOff, size, clear) (be9a91e) points HDP window win (registers [mem+0x80] + 0x44..0x48 + 6*win,
+// undocumented in Linux hdp 5.0/5.2) so a block inside the 256 MB BAR reaches a carve-out offset above
+// it. After Apple's call: read the registers back, then (on a thread, 300 ms later, after the CPU wrote)
+// compare BAR[bar] with carve[vramOff] and carve[bar] by physical address. Window works: BAR = carve
+// at vramOff. Window ignored by the 610M's HDP: BAR = carve at bar (the CPU's data lands in the
+// reserved block, the resource stays stale). Nothing is written.
+static uint64_t orgProgramHDP, orgMemPrepare, orgMemComplete;
+// One slot per HDP window: what was programmed, to compare when the window is taken down.
+struct HdpWin { bool valid; uint32_t call, reg46; uint64_t bar, voff, size; const char *who; };
+static HdpWin gHdpWin[32];
+static uint32_t gHdpCalls, gHdpCompares, gHdpStraddles;
+
+static uint64_t hdpLocal(uint64_t hwmem, uint64_t a) {
+	uint64_t mc = q(hwmem, 0x50);
+	return a >= mc && a < mc + q(hwmem, 0x40) ? a - mc : a;
+}
+
+// First window: does the physical carve-out read agree with the BAR where both reach (offset 0x1000)?
+// If not, no verdict below is worth anything.
+static void hdpFirst(uint64_t self) {
+	uint64_t b = vramRead64(0x1000), c = carveRead64(0x1000), b2 = vramRead64(0x8000000), c2 = carveRead64(0x8000000);
+	LOG("hdp: first window; HDP base %x, windows %u; HDP flush remap mem %x reg %x; self-check BAR/carve at 1000: %016llx %016llx, "
+		"at 8000000: %016llx %016llx -> %s", *reinterpret_cast<uint32_t *>(self + 0x80), *reinterpret_cast<uint32_t *>(self + 0x2c),
+		mmioRead(0xD20 + 0x12d), mmioRead(0xD20 + 0x12e), b, c, b2, c2,
+		b == c && b2 == c2 && c != ~0ULL ? "physical path OK" : "PHYSICAL PATH DISAGREES, verdicts invalid");
+}
+
+static void hdpNote(uint64_t self, const char *who, uint32_t w, uint64_t bar, uint64_t voff, uint64_t size) {
+	uint32_t call = ++gHdpCalls, base = *reinterpret_cast<uint32_t *>(self + 0x80);
+	if (call == 1)
+		hdpFirst(self);
+	uint32_t regs[5];
+	for (uint32_t k = 0; k < 5; k++)
+		regs[k] = mmioRead(base + 0x44 + k + 6 * w);
+	if (call <= 48 || !(call & 63))
+		LOG("hdp: #%u %s win %u bar %llx vram %llx size %llx; regs 44..48 = %x %x %x %x %x", call, who, w, bar, voff, size,
+			regs[0], regs[1], regs[2], regs[3], regs[4]);
+	if (w < arrsize(gHdpWin))
+		gHdpWin[w] = {true, call, regs[2], hdpLocal(self, bar), hdpLocal(self, voff), size, who};
+}
+
+// Window w is being cleared. Before Apple's call (window still live, the CPU has written through it):
+// BAR[bar] and register 0x46. After it (Apple flushed the HDP, hw->0x1f0, then took the window down):
+// carve[voff] and carve[bar] by physical address. Window works: BAR_before = carve[voff] != carve[bar].
+// Window ignored by the 610M's HDP: BAR_before = carve[bar] != carve[voff] (the CPU's data sits in the
+// reserved block, the resource stays stale). Verdict only if 0x46 still held what was programmed.
+struct HdpPre { bool on; uint32_t w, now; HdpWin n; uint64_t b[2]; };
+static HdpPre hdpBefore(uint64_t self, uint32_t w) {
+	HdpPre p {};
+	if (w >= arrsize(gHdpWin) || !gHdpWin[w].valid)
+		return p;
+	p.n = gHdpWin[w];
+	gHdpWin[w].valid = false;
+	if (gHdpCompares >= 48)
+		return p;
+	gHdpCompares++;
+	p.on = true;
+	p.w = w;
+	p.now = mmioRead(*reinterpret_cast<uint32_t *>(self + 0x80) + 0x46 + 6 * w);
+	p.b[0] = vramRead64(p.n.bar);
+	p.b[1] = p.n.size > 0x1000 ? vramRead64(p.n.bar + 0x1000) : 0;
+	return p;
+}
+
+static void hdpAfter(const HdpPre &p) {
+	if (!p.on)
+		return;
+	for (uint32_t k = 0; k < 2; k++) {
+		uint64_t o = k ? 0x1000 : 0;
+		if (k && p.n.size <= 0x1000)
+			break;
+		uint64_t b = p.b[k], cv = carveRead64(p.n.voff + o), cb = carveRead64(p.n.bar + o);
+		LOG("hdp: #%u %s win %u +%llx: BAR[bar] before clear %016llx, after: carve[voff] %016llx carve[bar] %016llx -> %s", p.n.call,
+			p.n.who, p.w, o, b, cv, cb, p.now != p.n.reg46 ? "undecided (window changed)" : b == cv && b != cb ? "WINDOW WORKS" :
+			b == cb && b != cv ? "WINDOW IGNORED (BAR shows its own block)" : b == cv ? "same data, undecided" : "neither");
+	}
+}
+
+// Kernel-internal CPU access path (prepareForCPUAccess / completeForCPUAccess).
+uint64_t wrapProgramHDP(uint64_t self, uint64_t win, uint64_t bar, uint64_t voff, uint64_t size, uint64_t clear) {
+	uint32_t w = win & 0xFF;
+	HdpPre p {};
+	if (clear & 0xFF)
+		p = hdpBefore(self, w);
+	auto r = reinterpret_cast<Fn6>(orgProgramHDP)(self, win, bar, voff, size, clear);
+	if (clear & 0xFF)
+		hdpAfter(p);
+	else
+		hdpNote(self, "cpu-access", w, bar, voff, size);
+	return r;
+}
+
+// Resource path (AMDAccelResource: shaders, IBs): prepare (be9a6ac) programs the window itself and keeps
+// it in [res+0x1bd] (0xff = direct BAR access); it only checks the START against the visible 256 MB
+// (+0x5d..+0x6a), so a resource that starts below and ends above goes direct past the BAR's end.
+uint64_t wrapMemPrepare(uint64_t self, uint64_t res, uint64_t off, uint64_t size, uint64_t ap, uint64_t f) {
+	auto r = reinterpret_cast<Fn6>(orgMemPrepare)(self, res, off, size, ap, f);
+	if (!res || !(r & 0xFF))  // failed prepare (+0x52/+0x55) leaves 0x1bd and *ap untouched
+		return r;
+	uint32_t w = *reinterpret_cast<uint8_t *>(res + 0x1bd);
+	uint64_t vis = q(self, 0x48);
+	if (w == 0xff) {
+		if (off < vis && off + size > vis && gHdpStraddles++ < 10)
+			LOG("hdp: resource %llx off %llx size %llx crosses the visible %llx: direct BAR access past its end (#%u)", res, off, size,
+				vis, gHdpStraddles);
+	} else if (ap)
+		hdpNote(self, "resource", w, *reinterpret_cast<uint64_t *>(ap), off, size);
+	return r;
+}
+
+uint64_t wrapMemComplete(uint64_t self, uint64_t res, uint64_t c, uint64_t d, uint64_t e, uint64_t f) {
+	HdpPre p {};
+	if (res && *reinterpret_cast<uint8_t *>(res + 0x1bd) != 0xff)
+		p = hdpBefore(self, *reinterpret_cast<uint8_t *>(res + 0x1bd));
+	auto r = reinterpret_cast<Fn6>(orgMemComplete)(self, res, c, d, e, f);
+	hdpAfter(p);
+	return r;
+}
+
 uint64_t wrapResetHardware(uint64_t self, uint64_t b, uint64_t c, uint64_t d, uint64_t e, uint64_t f) {
 	LOG("hw-reset: resetHardware(%llx)", b);
+	static uint32_t dumps;
+	if (gCarveRead && dumps++ < 3)
+		shaderDump("hang");
 	auto r = reinterpret_cast<Fn6>(orgResetHardware)(self, b, c, d, e, f);
 	syncSdmaAddrConfig("after resetHardware");
 	return r;
@@ -1063,6 +1186,16 @@ void probeRouteAccel(KernelPatcher &patcher, size_t index, mach_vm_address_t add
 		{"__ZN35AMDRadeonX6000_AMDAtomicBlitManager8doExpandEP15_UBM_EXPANDINFOPK11ABM_OPTIONS", wrapUbmOp<&orgDoExpand, 'E'>, orgDoExpand},
 	};
 	route(patcher, index, address, size, reqs, arrsize(reqs));
+	if (checkKernelArgument("-rmbhdpwatch")) {  // patch 0033: measurement only
+		gCarveRead = true;
