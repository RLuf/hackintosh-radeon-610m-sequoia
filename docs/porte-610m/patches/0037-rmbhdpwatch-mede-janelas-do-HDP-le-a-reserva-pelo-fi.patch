diff --git a/src/RembrandtGfx/vmwatch.cpp b/src/RembrandtGfx/vmwatch.cpp
index 268b659..9fba2d4 100644
--- a/src/RembrandtGfx/vmwatch.cpp
+++ b/src/RembrandtGfx/vmwatch.cpp
@@ -596,3 +596,36 @@ void mmhubDump(const char *why) {
 	buf[n] = 0;
 	LOG("mmhub: %s: enabled contexts%s", why, n ? buf : " none");
 }
+
+// Patch 0033 (-rmbhdpwatch), called at a GPU hang: the VS/PS shader addresses the chip holds
+// (SPI_SHADER_PGM_LO/HI_VS 0x19e8/9, _PS 0x19a8/9, gc_10_3_0_offset.h; GPU VA = LO << 8 | HI << 40),
+// plus the addresses seen in the 3D hang IBs, walked in every enabled VMID; 64 bytes of each shader.
+// Zeros (no s_endpgm 0xbf810000) mean the CPU's upload never reached the carve-out.
+// Also the NBIO HDP flush remap (REMAP_HDP_MEM/REG_FLUSH_CNTL 0xD20 + 0x12d/0x12e; Linux programs
+// the MMIO hole 0x7f000/0x7f004, nbio_v7_2.c:407-413).
+void shaderDump(const char *why) {
+	uint64_t vs = (uint64_t)gc(0x19e8) << 8 | (uint64_t)(gc(0x19e9) & 0xFF) << 40;
+	uint64_t ps = (uint64_t)gc(0x19a8) << 8 | (uint64_t)(gc(0x19a9) & 0xFF) << 40;
+	LOG("shader %s: PGM VS %llx PS %llx; HDP flush remap mem %x reg %x; carve phys %llx", why, vs, ps,
+		mmioRead(0xD20 + 0x12d), mmioRead(0xD20 + 0x12e), carvePhysBase());
+	const uint64_t vas[] {vs, ps, 0x400028b00ULL, 0x400028700ULL, 0x4001d0000ULL};
+	const char *names[] {"vs(reg)", "ps(reg)", "vs(ib)", "ps(ib)", "ib"};
+	for (uint32_t vmid = 1; vmid < 16; vmid++) {
+		if (!(gc(ctxCntl(vmid)) & 1))
+			continue;
+		for (uint32_t i = 0; i < arrsize(vas); i++) {
+			if (!vas[i] || (i >= 2 && (vas[i] == vs || vas[i] == ps)))
+				continue;
+			auto x = walk(vmid << 20, vas[i] >> 12, false);
+			if (!x.ok) {
+				LOG("shader %s: vmid %u %s va %llx not mapped", why, vmid, names[i], vas[i]);
+				continue;
+			}
+			LOG("shader %s: vmid %u %s va %llx -> %s %llx (pte %llx)", why, vmid, names[i], vas[i],
+				x.sys ? "system" : "carve off", x.addr + (vas[i] & 0xFFF), x.pte);
+			char tag[48];
+			snprintf(tag, sizeof(tag), "shader %s %s", why, names[i]);
+			dumpGpuVa(tag, vmid, vas[i], 16);
+		}
+	}
+}
