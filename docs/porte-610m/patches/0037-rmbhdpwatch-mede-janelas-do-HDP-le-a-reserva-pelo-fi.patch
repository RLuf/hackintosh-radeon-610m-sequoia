+// Patch 0033 (-rmbhdpwatch): offsets past the BAR window read the carve-out at its physical address
+// (FB_OFFSET << 24, 0x3c0000000 here), one uncached page at a time, without MM_INDEX (barred under the
+// probe) and without the BAR/HDP. Read only. Linux on an APU reaches the whole carve-out this way.
+bool gCarveRead;
+static IOMemoryDescriptor *gCarveMd;
+static IOMemoryMap *gCarvePage;
+static uint64_t gCarvePageOff = ~0ULL;
+
+uint64_t carvePhysBase() {
+	return (uint64_t)(mmioRead(0x1260 + 0x16e7) & 0xFFFFFF) << 24;
+}
+
+// Caller holds vramLock.
+static bool carveRead64Locked(uint64_t off, uint64_t &v) {
+	uint64_t base = carvePhysBase();
+	if (!base || base == 0xFFFFFFull << 24 || off >= 0x80000000ULL)
+		return false;
+	uint64_t page = off & ~0xFFFULL;
+	if (page != gCarvePageOff) {
+		if (gCarvePage)
+			gCarvePage->release();
+		if (gCarveMd)
+			gCarveMd->release();
+		gCarvePage = nullptr;
+		gCarvePageOff = ~0ULL;
+		gCarveMd = IOMemoryDescriptor::withAddressRange(base + page, 0x1000, kIODirectionIn, nullptr);
+		if (!gCarveMd)
+			return false;
+		gCarvePage = gCarveMd->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapInhibitCache, 0, 0x1000);
+		if (!gCarvePage)
+			return false;
+		gCarvePageOff = page;
+	}
+	v = *reinterpret_cast<volatile uint64_t *>(gCarvePage->getVirtualAddress() + (off & 0xFFF));
+	return true;
+}
+
+// Carve-out read by physical address at any offset (only with -rmbhdpwatch); ~0 if unavailable.
+uint64_t carveRead64(uint64_t off) {
+	auto l = gCarveRead ? vramLock() : nullptr;
+	if (!l)
+		return ~0ULL;
+	IOLockLock(l);
+	uint64_t v;
+	if (!carveRead64Locked(off, v))
+		v = ~0ULL;
+	IOLockUnlock(l);
+	return v;
+}
+
 uint64_t vramRead64(uint64_t off) {
 	if (!findVram())
 		return ~0ULL;
@@ -160,7 +210,10 @@ uint64_t vramRead64(uint64_t off) {
 		return ~0ULL;
 	IOLockLock(l);
