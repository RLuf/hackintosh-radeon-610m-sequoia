+			{"__ZN31AMDRadeonX6000_AMDGFX10HWMemory26programOrClearHDPRegistersEhyyyb", wrapProgramHDP, orgProgramHDP},
+			{"__ZN31AMDRadeonX6000_AMDGFX10HWMemory7prepareEP31AMDRadeonX6000_AMDAccelResourceyyPy", wrapMemPrepare, orgMemPrepare},
+			{"__ZN31AMDRadeonX6000_AMDGFX10HWMemory8completeEP31AMDRadeonX6000_AMDAccelResource", wrapMemComplete, orgMemComplete},
+		};
+		route(patcher, index, address, size, hr, arrsize(hr));
+		LOG("hdpwatch: HDP window checks on, carve-out read by physical address past the BAR, shader dump at hangs");
