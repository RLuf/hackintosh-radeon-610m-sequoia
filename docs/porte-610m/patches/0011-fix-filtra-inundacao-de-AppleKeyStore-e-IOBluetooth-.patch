From 4d1f293ba2fa25bd493a00d51bc476262648de26 Mon Sep 17 00:00:00 2001
From: fzmac <noreply@example.invalid>
Date: Tue, 24 Nov 2026 06:32:30 -0800
Subject: [PATCH 11/48] fix: filtra inundacao de AppleKeyStore e IOBluetooth em
 _console_write

---
 src/RembrandtGfx/disklog.cpp | 39 ++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/src/RembrandtGfx/disklog.cpp b/src/RembrandtGfx/disklog.cpp
index d3aa7e4..9a21ec5 100644
--- a/src/RembrandtGfx/disklog.cpp
+++ b/src/RembrandtGfx/disklog.cpp
@@ -171,6 +171,35 @@ bool noise(const char *l, int n) {
 
 char gKeep[2000];
 int gKeepLen;
+mach_vm_address_t orgConsoleWrite, orgOsLogWithArgs;
+
+void wrapConsoleWrite(const char *buf, int len) {
+	if (buf && len > 0) {
+		static const char *const drop[] {"\"AppleKeyStore\"", "**** [IOBluetooth"};
+		for (auto pat : drop) {
+			int m = static_cast<int>(strlen(pat));
+			for (int i = 0; i + m <= len; i++)
+				if (!strncmp(buf + i, pat, m))
+					return;
+		}
+	}
+	FunctionCast(wrapConsoleWrite, orgConsoleWrite)(buf, len);
+}
+
+void wrapOsLogWithArgs(void *oslog, uint32_t type, const char *fmt, void *args, void *addr) {
+	if (fmt) {
+		static const char *const drop[] {
+			"unexpected session uid:",
+			"operation %s(sel:",
+			"**** [IOBluetooth",
+			"\"AppleKeyStore\"",
+		};
+		for (auto pat : drop)
+			if (strstr(fmt, pat))
+				return;
+	}
+	FunctionCast(wrapOsLogWithArgs, orgOsLogWithArgs)(oslog, type, fmt, args, addr);
+}
 
 }  // namespace
 
@@ -387,6 +416,16 @@ void keepPanic() { stallPanic(*gMsgbufp, 0); }
 
 
 void diskLogStart(KernelPatcher &patcher) {
+	if (!checkKernelArgument("-rmbakslog")) {
+		KernelPatcher::RouteRequest cwReq {"_console_write", wrapConsoleWrite, orgConsoleWrite};
+		bool cwOk = patcher.routeMultiple(KernelPatcher::KernelID, &cwReq, 1);
+		patcher.clearError();
+		KernelPatcher::RouteRequest olReq {"_os_log_with_args", wrapOsLogWithArgs, orgOsLogWithArgs};
+		bool olOk = patcher.routeMultiple(KernelPatcher::KernelID, &olReq, 1);
+		patcher.clearError();
+		LOG("disklog: AppleKeyStore/IOBluetooth filter console=%s oslog=%s (-rmbakslog keeps raw)",
+		    cwOk ? "ok" : "FAIL", olOk ? "ok" : "FAIL");
+	}
 	if (checkKernelArgument("-rmbnodisklog"))
 		return;
 	gMsgbufp = reinterpret_cast<MsgBuf **>(patcher.solveSymbol(KernelPatcher::KernelID, "_msgbufp"));
-- 
