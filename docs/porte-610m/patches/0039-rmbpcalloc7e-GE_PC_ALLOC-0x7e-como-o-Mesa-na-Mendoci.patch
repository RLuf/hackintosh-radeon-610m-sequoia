+	// -> movl $0x3f; leal 0x0(,%rax,2): (0x1ff & 0x3f) << 1 = 0x7e. The 18 bytes are unique in the driver.
+	{{0xb8, 0xff, 0x03, 0x00, 0x00, 0x23, 0x87, 0xac, 0x00, 0x00, 0x00, 0x8d, 0x04, 0x45, 0x01, 0x00, 0x00, 0x00}, 18, 0, 0, 0,
