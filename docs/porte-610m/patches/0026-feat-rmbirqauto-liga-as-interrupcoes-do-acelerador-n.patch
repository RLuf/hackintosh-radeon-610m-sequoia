+// Shutdown and restart (firmware.cpp powerHandler), before the engines are halted and, on restart,
+// before the SMU resets GFX: with the ring and the MSI still live, an interrupt arriving while the
+// chip resets would make Apple's handler read the write pointer from a dead register.
+void irqStopForShutdown(const char *why) {
+	if (!gIrqMgr || !gIrqLive)
+		return;
+	gIrqLive = false;
+	ihStopNow(why);
+	auto pci = *reinterpret_cast<IOService **>(gIrqMgr + 0x30);
+	int idx = *reinterpret_cast<int32_t *>(gIrqMgr + 0x58);
+	if (pci && idx >= 0)
+		LOG("irq: %s: disableInterrupt(%d) = %x", why, idx, pci->disableInterrupt(idx));
+}
