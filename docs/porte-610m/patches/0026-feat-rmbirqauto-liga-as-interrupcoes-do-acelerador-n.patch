+// AMDHardware::enableInterrupts); what tells success is [hw+0x319] going to 1.
+static void sendMsg1b(uint64_t ctrl, const char *how) {
+	accelState4a(ctrl, "msg1b", "before");
+	s3Sample("before msg1b");
+	auto r = wrapMessageAccelerator(reinterpret_cast<void *>(ctrl), 0x1b, 0, 0, 0, 0);
+	LOG("4a: msg1b sent (%s), messageAccelerator(0x1b) = %llx (lo32 %llx; e00002c7 is the normal return)", how, r, r & 0xFFFFFFFF);
+	accelState4a(ctrl, "msg1b", "after");
+	s3Sample("after msg1b");
+	ihSnap("after msg1b");
