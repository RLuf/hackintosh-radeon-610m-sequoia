From 43778b33998e25573804632f96b0bf91b010b410 Mon Sep 17 00:00:00 2001
From: Roger Luft <rluft@pop.local>
Date: Thu, 26 Nov 2026 02:06:43 -0300
Subject: [PATCH 35/48] -rmbpclines256: parameter cache em 256 linhas no driver
 Metal; dump do IB em 0x1000 (0031)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KLHgSnTLAbgqeuDELHd7ED
---
 src/RembrandtGfx/kern_start.cpp |  2 +-
 src/RembrandtGfx/probe.cpp      |  4 ++--
 src/RembrandtGfx/umdpatch.cpp   | 29 ++++++++++++++++++-----------
 3 files changed, 21 insertions(+), 14 deletions(-)

diff --git a/src/RembrandtGfx/kern_start.cpp b/src/RembrandtGfx/kern_start.cpp
index e5fb61f..795f536 100644
--- a/src/RembrandtGfx/kern_start.cpp
+++ b/src/RembrandtGfx/kern_start.cpp
@@ -1288,7 +1288,7 @@ static uint64_t stage3_ttl_hw_init(uint64_t a, uint64_t b, uint64_t c, uint64_t
 	}
 	gStage3Armed = true;
 	LOG("stage 3: preflight passed, hardware init allowed");
-	LOG("stage 3: kext patch 0030, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s; framebuffers %s; accelerator message 6 %s",
+	LOG("stage 3: kext patch 0031, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s; framebuffers %s; accelerator message 6 %s",
 	    checkKernelArgument("-rmbacceptrlc") ? "ON (-rmbacceptrlc)" : "off",
 	    checkKernelArgument("-rmbsendasd") ? "sent (-rmbsendasd)" : "not sent",
 	    checkKernelArgument("-rmbcamcheck") ? "Apple's (-rmbcamcheck)" : "skipped",
diff --git a/src/RembrandtGfx/probe.cpp b/src/RembrandtGfx/probe.cpp
index 9de38a9..9f8dacd 100644
--- a/src/RembrandtGfx/probe.cpp
+++ b/src/RembrandtGfx/probe.cpp
@@ -1029,9 +1029,9 @@ void probeRouteAccel(KernelPatcher &patcher, size_t index, mach_vm_address_t add
 		} else if (MachInfo::setKernelWriting(true, KernelPatcher::kernelWriteLock) != KERN_SUCCESS) {
 			LOG("ibdump: kernel writing failed");
 		} else {
-			p[4] = 0x04;  // 0x100 -> 0x400 dwords
+			p[4] = 0x10;  // 0x100 -> 0x1000 dwords (0031; was 0x400 in 0029)
 			MachInfo::setKernelWriting(false, KernelPatcher::kernelWriteLock);
-			LOG("ibdump: gpuRestart reports now dump up to 0x400 IB dwords (was 0x100)");
+			LOG("ibdump: gpuRestart reports now dump up to 0x1000 IB dwords (was 0x100)");
 		}
 	}
 	KernelPatcher::RouteRequest reqs[] {
diff --git a/src/RembrandtGfx/umdpatch.cpp b/src/RembrandtGfx/umdpatch.cpp
index 7ed9245..fe6f52e 100644
--- a/src/RembrandtGfx/umdpatch.cpp
+++ b/src/RembrandtGfx/umdpatch.cpp
@@ -27,16 +27,22 @@ constexpr size_t xorRepOff = 13;
 //   amdMtl_GFX10_InitRenderPipelineHwCtxRegs: movq $0x60201b8,0x48(%rbx)  -> 0x60201a8
 //   Gfx10BltDrawRegs::InitContextRegs:        orl  $0x60201b0,%ecx        -> 0x60201a0
 struct WfPat {
-	uint8_t pat[8];
+	uint8_t pat[16];
 	size_t len, off;
 	uint8_t from, to;
 	const char *name;
+	int arg;  // 0 = -rmbwalkfence2, 1 = -rmbpclines256
 };
 const WfPat wfPats[] {
-	{{0x48, 0xc7, 0x43, 0x48, 0xb8, 0x01, 0x02, 0x06}, 8, 4, 0xb8, 0xa8, "render pipeline"},
-	{{0x81, 0xc9, 0xb0, 0x01, 0x02, 0x06}, 6, 2, 0xb0, 0xa0, "blt draw"},
+	{{0x48, 0xc7, 0x43, 0x48, 0xb8, 0x01, 0x02, 0x06}, 8, 4, 0xb8, 0xa8, "render pipeline", 0},
+	{{0x81, 0xc9, 0xb0, 0x01, 0x02, 0x06}, 6, 2, 0xb0, 0xa0, "blt draw", 0},
+	// Patch 0031 (-rmbpclines256): gfx10_HwInfoInitData +0xac = min(512*numSE - 1, 0x3ff) feeds
+	// GE_PC_ALLOC.NUM_PC_LINES (0x3ff in the IB = OVERSUB_EN + 512 lines); the Mendocino has 256 parameter
+	// cache lines (Mesa ac_gpu_info.c). mov 0x78(%rdi),%eax; mov %eax,%ecx; shl $9,%ecx -> shl $8,%ecx
+	{{0x8b, 0x47, 0x78, 0x89, 0xc1, 0xc1, 0xe1, 0x09, 0xff, 0xc9, 0xba, 0xff, 0x03, 0x00, 0x00}, 15, 7, 0x09, 0x08,
+	 "GE_PC_ALLOC lines 512 -> 256", 1},
 };
-bool gDoXor, gDoWf;
+bool gDoXor, gDoWf, gDoPc;
 uint32_t gWfPatched;
 
 mach_vm_address_t orgCsValidateRange;
@@ -57,7 +63,7 @@ void writeRep(uint8_t *at, const char *how, size_t off) {
 
 void patchWalkFence(uint8_t *p, size_t size) {
 	for (auto &w : wfPats) {
-		if (size < w.len)
+		if ((w.arg == 0 && !gDoWf) || (w.arg == 1 && !gDoPc) || size < w.len)
 			continue;
 		for (size_t o = 0, end = size - w.len; o <= end; o++) {
 			if (p[o] != w.pat[0] || memcmp(p + o, w.pat, w.len))
@@ -69,15 +75,15 @@ void patchWalkFence(uint8_t *p, size_t size) {
 			p[o + w.off] = w.to;
 			MachInfo::setKernelWriting(false, KernelPatcher::kernelWriteLock);
 			if (++gWfPatched <= 8)
-				LOG("umd: PA_SC_MODE_CNTL_1 WALK_FENCE_SIZE 3 -> 2 (%s, page off 0x%lx, #%u)", w.name,
-				    (unsigned long)o, gWfPatched);
+				LOG("umd: %s (%s, page off 0x%lx, #%u)", w.arg ? "HwInfo +0xac" : "PA_SC_MODE_CNTL_1 WALK_FENCE_SIZE 3 -> 2",
+				    w.name, (unsigned long)o, gWfPatched);
 		}
 	}
 }
 
 void patchPage(const void *data, size_t size) {
 	auto p = static_cast<uint8_t *>(const_cast<void *>(data));
-	if (p && gDoWf)
+	if (p && (gDoWf || gDoPc))
 		patchWalkFence(p, size);
 	if (!gDoXor || !p || size < sizeof(xorPat))
 		return;
@@ -119,7 +125,8 @@ void wrapCsValidatePage(void *vp, memory_object_t pager, memory_object_offset_t
 void umdRoute(KernelPatcher &patcher) {
 	gDoXor = !rmbProbe() && !checkKernelArgument("-rmbnoxor0");
 	gDoWf = checkKernelArgument("-rmbwalkfence2");  // patch 0030, also in probe stages
-	if (!gDoXor && !gDoWf)
+	gDoPc = checkKernelArgument("-rmbpclines256");  // patch 0031
+	if (!gDoXor && !gDoWf && !gDoPc)
 		return;
 	KernelPatcher::RouteRequest req[] {
 		{"_cs_validate_page", wrapCsValidatePage, orgCsValidatePage},
@@ -128,7 +135,7 @@ void umdRoute(KernelPatcher &patcher) {
 	if (!patcher.routeMultipleLong(KernelPatcher::KernelID, req, arrsize(req)))
 		LOG("umd: failed to route cs_validate_page/range (err %d)", patcher.getError());
 	else
-		LOG("umd: page patch installed (cs_validate_page + range): pipeBankXor 0 %s, walk fence 2 %s",
-		    gDoXor ? "on" : "off", gDoWf ? "on" : "off");
+		LOG("umd: page patch installed (cs_validate_page + range): pipeBankXor 0 %s, walk fence 2 %s, pc lines 256 %s",
+		    gDoXor ? "on" : "off", gDoWf ? "on" : "off", gDoPc ? "on" : "off");
 	patcher.clearError();
 }
