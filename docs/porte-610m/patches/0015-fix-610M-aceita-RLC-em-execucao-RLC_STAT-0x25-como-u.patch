From 8722a789f5b477f5a64b0f799818069573e8f25b Mon Sep 17 00:00:00 2001
From: fzmac <noreply@example.invalid>
Date: Tue, 24 Nov 2026 10:12:24 -0800
Subject: [PATCH 15/48] fix: 610M aceita RLC em execucao (RLC_STAT 0x25) como
 ucode carregado, como o Linux em APU

---
 src/RembrandtGfx/kern_start.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/RembrandtGfx/kern_start.cpp b/src/RembrandtGfx/kern_start.cpp
index 072b13b..4ae73ed 100644
--- a/src/RembrandtGfx/kern_start.cpp
+++ b/src/RembrandtGfx/kern_start.cpp
@@ -780,6 +780,16 @@ static uint64_t wrap_gc_check_ucode_loaded_10_1(uint64_t gc, uint64_t b, uint64_
 	uint32_t grbm = mmioRead(0x1260 + 0x0da4);
 	LOG("gc_check_ucode_loaded: exit r=%llx; RLC_CNTL=%x RLC_STAT=%x BOOTLOAD=%x CP_STAT=%x GRBM=%x",
 	    r & 0xFFFFFFFF, rlcCntl, rlcStat, bootload, cpStat, grbm);
+	// Mendocino (APU, PSP 13.0.8): Linux never uses RLC backdoor autoload here (psp->autoload_supported
+	// is false for MP0 13.0.x APUs); the PSP loads and starts the RLC itself and BOOTLOAD_STATUS stays 0.
+	// Apple's own APU variant of _gc_fw_autoload_is_completed (gc+0x329 set) expects RLC_STAT == 0x25,
+	// which is exactly the running-RLC state seen here. Accept it (-rmbstrictbootload: don't).
+	if ((r & 0xFFFFFFFF) != 0 && gcHwVersion() == 0xa0307 && (rlcCntl & 1) && rlcStat == 0x25 &&
+	    !checkKernelArgument("-rmbstrictbootload")) {
+		LOG("gc_check_ucode_loaded: Mendocino PSP front-door load, RLC running (RLC_CNTL=%x RLC_STAT=%x) -> returning 0",
+		    rlcCntl, rlcStat);
+		return 0;
+	}
 	if ((r & 0xFFFFFFFF) != 0) {
 		for (int ms = 0; ms < 400 && ((bootload & 0x80000000u) == 0 || bootload == 0xFFFFFFFFu); ms += 10) {
 			IODelay(10000);
-- 
