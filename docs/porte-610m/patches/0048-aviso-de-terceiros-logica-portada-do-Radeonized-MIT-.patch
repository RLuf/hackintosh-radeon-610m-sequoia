 src/RembrandtGfx/display.cpp | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/src/RembrandtGfx/display.cpp b/src/RembrandtGfx/display.cpp
index e6dff76..94ee92c 100644
--- a/src/RembrandtGfx/display.cpp
+++ b/src/RembrandtGfx/display.cpp
@@ -3973,6 +3973,29 @@ IOReturn agdcExtCap(void *agdc, uint8_t *req, size_t size) {
 // and src/common/rb_otg.h rb_otg_to_v2): link id 0xFFFFFFFF, flags 0x08|0x02 (no link; bit 0 clear,
 // so 0x925/0x988 are not asked), stream +0xa4 = 0, state +0xac = 0x80000000.
 // Totals follow Linux's optc programming (register = total - 1), as gMode.htot/vtot already do.
