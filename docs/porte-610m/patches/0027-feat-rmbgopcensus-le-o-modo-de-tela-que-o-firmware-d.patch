+// Patch 0027 (-rmbgopcensus, opt-in, READ-ONLY): what the firmware left lit on the DCN 3.1.6, the
+// input for a framebuffer that inherits the GOP mode instead of running Apple's DAL. Every offset
+// is a DCN segment-2 dword (DMU base 0x34C0, ipdisc hw_id 271) and is identical in Linux v6.12
+// dcn_3_1_2_offset.h and dcn_3_1_6_offset.h (6402 common registers, no offset differs). Nothing is
+// written: mmioRead only, plus IORegistry property reads on the framebuffer stub.
+// -rmbgopcensus absent: this function returns at once.
+static void gopCensus(IOService *fb0, const char *when) {
+	if (!checkKernelArgument("-rmbgopcensus") || !mmioAvailable())
+		return;
+	constexpr uint32_t D = 0x34C0;
+	constexpr uint32_t HubpStride = 0xdc, OtgStride = 0x80;
+	for (uint32_t i = 0; i < 4; i++) {
+		uint32_t h = D + i * HubpStride, o = D + i * OtgStride;
+		// OTGn: CONTROL 0x1b41, H_TOTAL 0x1b2a, H_BLANK 0x1b2b, V_TOTAL 0x1b2f, V_BLANK 0x1b36,
+		// STATUS_POSITION 0x1b4a, STATUS_FRAME_COUNT 0x1b4c; ODMn OPTC_DATA_SOURCE_SELECT 0x1acb (+0x10/inst).
+		LOG("gop %s: OTG%u CONTROL %x H_TOTAL %x H_BLANK %x V_TOTAL %x V_BLANK %x POS %x FRAMES %x ODM_SRC %x", when, i,
+		    mmioRead(o + 0x1b41), mmioRead(o + 0x1b2a), mmioRead(o + 0x1b2b), mmioRead(o + 0x1b2f), mmioRead(o + 0x1b36),
+		    mmioRead(o + 0x1b4a), mmioRead(o + 0x1b4c), mmioRead(D + 0x1acb + i * 0x10));
+		// HUBPn: SURFACE_CONFIG 0x5e5, ADDR_CONFIG 0x5e6, TILING 0x5e7, PRI_VIEWPORT_DIMENSION 0x5ea,
+		// CLK_CNTL 0x5f4, PITCH 0x607, PRIMARY_ADDR 0x60a / HIGH 0x60b, FLIP_CONTROL 0x61b.
+		LOG("gop %s: HUBP%u CFG %x ADDR_CFG %x TILING %x VIEWPORT %x CLK %x PITCH %x ADDR %x_%08x FLIP %x DET %x", when, i,
+		    mmioRead(h + 0x5e5), mmioRead(h + 0x5e6), mmioRead(h + 0x5e7), mmioRead(h + 0x5ea), mmioRead(h + 0x5f4),
+		    mmioRead(h + 0x607), mmioRead(h + 0x60b), mmioRead(h + 0x60a), mmioRead(h + 0x61b), mmioRead(D + 0x4cc + i));
+	}
+	// HUBP0 again, what a GOP-inheriting framebuffer will touch or must preserve: PRI_VIEWPORT_START
+	// 0x5e9, PITCH_C 0x608, SECONDARY_ADDR 0x60e, SURFACE_CONTROL 0x61a, SURFACE_INUSE 0x621 / HIGH
+	// 0x622 (the address being scanned out now), HUBPRET_CONTROL 0x66c; OTG0 MASTER_EN 0x1b5c.
+	LOG("gop %s: HUBP0 VP_START %x PITCH_C %x SEC_ADDR %x SURF_CTL %x INUSE %x_%08x HUBPRET %x; OTG0 MASTER_EN %x", when,
+	    mmioRead(D + 0x5e9), mmioRead(D + 0x608), mmioRead(D + 0x60e), mmioRead(D + 0x61a), mmioRead(D + 0x622),
+	    mmioRead(D + 0x621), mmioRead(D + 0x66c), mmioRead(D + 0x1b5c));
+	// The console the firmware handed to the kernel (GOP framebuffer): CPU physical address and geometry.
+	PE_Video v {};
+	if (auto pe = IOService::getPlatform(); pe && pe->getConsoleInfo(&v) == kIOReturnSuccess)
+		LOG("gop %s: firmware console base %lx rowBytes %lu %lux%lu depth %lu display %lu", when, v.v_baseAddr, v.v_rowBytes,
+		    v.v_width, v.v_height, v.v_depth, v.v_display);
+	else
+		LOG("gop %s: firmware console info not available", when);
+	// DCHUBBUB_COMPBUF_CTRL 0x4cb, DPP0 DPP_CONTROL 0xcc5, CNVC0 FORMAT_CONTROL 0xcd0, DIG0 FE 0x208b /
+	// BE 0x20b0, DP0 LINK_CNTL 0x2108 / CONFIG 0x210b, PWRSEQ0 BL_PWM_CNTL 0x2f19 / PERIOD 0x2f1b,
+	// DMCUB CNTL 0x1f6 / CNTL2 0x200 / SCRATCH0 0x1e3 / SCRATCH14 0x1f1 (boot options).
+	LOG("gop %s: COMPBUF %x DPP0 %x CNVC0 %x DIG0 FE %x BE %x DP0 LINK %x CFG %x BL_PWM %x PERIOD %x DMCUB %x/%x S0 %x S14 %x",
+	    when, mmioRead(D + 0x4cb), mmioRead(D + 0xcc5), mmioRead(D + 0xcd0), mmioRead(D + 0x208b), mmioRead(D + 0x20b0),
+	    mmioRead(D + 0x2108), mmioRead(D + 0x210b), mmioRead(D + 0x2f19), mmioRead(D + 0x2f1b), mmioRead(D + 0x1f6),
+	    mmioRead(D + 0x200), mmioRead(D + 0x1e3), mmioRead(D + 0x1f1));
+	// Refresh rate without the pixel clock: OTG0 frame counter over 1 s (only if OTG0 is enabled).
+	if (mmioRead(D + 0x1b41) & 1) {
+		uint32_t f0 = mmioRead(D + 0x1b4c);
+		IOSleep(1000);
+		uint32_t f1 = mmioRead(D + 0x1b4c);
+		LOG("gop %s: OTG0 frame counter %x -> %x in 1000 ms (%u frames)", when, f0, f1, f1 - f0);
+	}
+	// What the accelerator's AMDHWDisplay::getDisplayInfo will read from this stub (Radeonized's
+	// journal, 15.x X6000: 'ATY,fb_offset' and friends), and what IOFramebuffer published.
+	static const char *const keys[] {"ATY,fb_offset", "ATY,fb_linebytes", "ATY,fb_size", "IOFBCurrentPixelCount",
+	                                  "IOFBMemorySize", "AAPL,boot-display", "connector-type", "display-connect-flags"};
+	for (auto k : keys) {
+		auto p = fb0 ? fb0->getProperty(k) : nullptr;
+		if (auto d = OSDynamicCast(OSData, p))
+			LOG("gop %s: fb0 %s = data[%u] %08x", when, k, d->getLength(),
+			    d->getLength() >= 4 ? *static_cast<const uint32_t *>(d->getBytesNoCopy()) : 0);
+		else if (auto n = OSDynamicCast(OSNumber, p))
+			LOG("gop %s: fb0 %s = %llu", when, k, n->unsigned64BitValue());
+		else
+			LOG("gop %s: fb0 %s %s", when, k, p ? "(other type)" : "absent");
+	}
+}
+
+// The same census on request (NVRAM trigger rmb-census, kern_start.cpp), any time after boot.
+void displayGopCensus(const char *when) {
+	IOService *fb0 = nullptr;
+	auto matching = IOService::serviceMatching("AMDRadeonX6000_AmdRadeonFramebuffer");
+	auto iter = matching ? IOService::getMatchingServices(matching) : nullptr;
+	OSSafeReleaseNULL(matching);
+	while (auto svc = iter ? OSDynamicCast(IOService, iter->getNextObject()) : nullptr) {
+		auto loc = svc->getLocation();
+		if (!fb0 && loc && !strcmp(loc, "0")) {
+			fb0 = svc;
+			fb0->retain();
+		}
+	}
+	OSSafeReleaseNULL(iter);
+	gopCensus(fb0, when);
+	OSSafeReleaseNULL(fb0);
+}
+
 // Sub-stage 4a (rmbstage=3 plus -rmbfbstubs), patch 0023. Measured at the boot of 24/11 19:33: the
 // accelerator exists but every Metal allocation sleeps in IOGraphicsAccelerator2::
 // acceleratorWaitEnabled(). The enabled bit ([accel+0xc78] & 2, IOAcceleratorFamily2 of 15.8.1) is
@@ -3281,6 +3368,7 @@ static void stage4aOpen(void *, wait_result_t) {
 	}
 	OSSafeReleaseNULL(iter);
 	LOG("4a: %u AmdRadeonFramebuffer services, framebuffer 0 %s", count, fb0 ? "found" : "NOT found");
+	gopCensus(fb0, "before open");
 	if (fb0 && !checkKernelArgument("-rmbnoopen")) {
 		auto vt = *reinterpret_cast<mach_vm_address_t **>(fb0);
 		size_t slot = 0;
@@ -3299,6 +3387,11 @@ static void stage4aOpen(void *, wait_result_t) {
 	LOG("4a: after open: accel flags %x (enabled %d) vram desc %s; DMCUB_CNTL %x CNTL2 %x SCRATCH0 %x", accelFlags(accel),
 	    (accelFlags(accel) >> 1) & 1, accelVram(accel) ? "set" : "null", mmioAvailable() ? mmioRead(DcnSeg2 + 0x1f6) : 0,
 	    mmioAvailable() ? mmioRead(DcnSeg2 + 0x200) : 0, mmioAvailable() ? mmioRead(DcnSeg2 + 0x1e3) : 0);
+	gopCensus(fb0, "after open");
+	if (checkKernelArgument("-rmbgopcensus")) {
+		IOSleep(30000);
+		gopCensus(fb0, "30 s after open");  // WindowServer has tried (and failed) by now
+	}
 	OSSafeReleaseNULL(fb0);
 	accel->release();
 }
