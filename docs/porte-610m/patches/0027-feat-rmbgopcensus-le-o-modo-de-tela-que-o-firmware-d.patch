 	}
 	opts->release();
 	bool ignIrq = value("rmb-irq") >= 0, ignMsg = value("rmb-msg1b") >= 0;
+	// Patch 0027: rmb-census repeats the read-only display census each time the variable appears
+	// (delete it and set it again for another one). Needs -rmbgopcensus; present at boot = ignored.
+	bool censusOn = checkKernelArgument("-rmbgopcensus"), censusSeen = value("rmb-census") >= 0, censusIgn = censusSeen;
+	uint32_t censusCount = 0;
 	if (ignIrq)
 		LOG("4a: triggers: NVRAM variable rmb-irq already present at boot: ignored for this whole boot (sudo nvram -d rmb-irq)");
 	if (ignMsg)
@@ -414,12 +418,26 @@ static void msg1bThread(void *, wait_result_t) {
 	// The watchdog runs for as long as the ring is alive; the triggers are read for 4 hours.
 	for (uint32_t tick = 0;; tick++) {
 		bool triggersOpen = tick < 4 * 3600 * 10 && !((ignIrq || gIrqDone) && (ignMsg || gMsg1bDone));
-		if (!gIrqLive && !triggersOpen)
+		bool censusOpen = censusOn && tick < 4 * 3600 * 10;
+		if (!gIrqLive && !triggersOpen && !censusOpen)
 			break;
 		IOSleep(100);
 		if (gIrqLive && irqWatch())
 			gIrqLive = false;
-		if (tick % 10 || !triggersOpen)
+		if (tick % 10)
+			continue;
+		if (censusOpen) {
+			bool now = value("rmb-census") >= 0;
+			if (!now)
+				censusIgn = false;  // deleted: the next appearance counts
+			else if (!censusSeen && !censusIgn) {
+				char when[24];
+				snprintf(when, sizeof(when), "on request %u", ++censusCount);
+				displayGopCensus(when);
+			}
+			censusSeen = now;
+		}
+		if (!triggersOpen)
 			continue;
 		uint64_t ctrl = gCtrl4a;
 		if (!ignIrq && !gIrqDone) {
@@ -1261,7 +1279,7 @@ static uint64_t stage3_ttl_hw_init(uint64_t a, uint64_t b, uint64_t c, uint64_t
 	}
 	gStage3Armed = true;
 	LOG("stage 3: preflight passed, hardware init allowed");
-	LOG("stage 3: kext patch 0026, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s; framebuffers %s; accelerator message 6 %s",
+	LOG("stage 3: kext patch 0027, built " __DATE__ " " __TIME__ "; forced RLC accept %s; asd %s; cam check %s; gart clean %s; utcl2 harvest %s; framebuffers %s; accelerator message 6 %s",
 	    checkKernelArgument("-rmbacceptrlc") ? "ON (-rmbacceptrlc)" : "off",
 	    checkKernelArgument("-rmbsendasd") ? "sent (-rmbsendasd)" : "not sent",
 	    checkKernelArgument("-rmbcamcheck") ? "Apple's (-rmbcamcheck)" : "skipped",
