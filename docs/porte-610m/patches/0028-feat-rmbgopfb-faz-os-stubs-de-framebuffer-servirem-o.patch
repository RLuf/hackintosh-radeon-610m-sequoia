+// Patch 0028 (-rmbgopfb, opt-in; needs rmbstage=3 -rmbfbstubs): Apple's AmdRadeonFramebuffer stubs
+// serve the mode the firmware left lit on the eDP, without the DAL and without writing the DCN.
+// The IOGraphics side (IOGraphics-599 IOFramebuffer.cpp, the 15.8.1 kext is IOGraphicsFamily 599):
+// open() needs enableController() == 0 (:9119-9131), then registers 'vbl ' / 'dci ' / 'dpir'
+// interrupts (:9195, :9245, :9257), asks 'crsr' (:9268) and 'lddc' (:9282), and updateOnline()
+// asks 'cena' on connection 0 (:7770, online = error || value: offline needs SUCCESS with 0) and,
+// offline, looks for a mode whose appleTimingID is kIOTimingIDApple_0x0_0hz_Offline (:7799-7820).
+// postOpen -> initFB() needs getCurrentDisplayMode + getPixelInformation(kIOFBSystemAperture)
+// (:9685-9700) and skips the console init when either fails. CoreDisplay asserts unless EVERY
+// framebuffer it enumerates opens (CGXMappedDisplayStart, MappedDisplay.cpp:5491/5509, "Driver
+// Error: %ld of %ld framebuffers were successfully opened"), so fb 1 and fb 2 open too, offline.
+// The answers copy IONDRVSupport's IOBootNDRV (IONDRVFramebuffer.cpp:4382-4460, 4526-4600): one
+// mode, geometry and base from PE_Video, aperture = sub-range of the device memory holding the
+// console, appleTimingID 0 with Valid|Safe. The accelerator's display pipe (AMDRadeonX6000 15.8.1)
+// registers 'txni' / 'fstr' on the framebuffer (be497eb, be49874), hands each transaction to
+// setAttribute('amtr', pipe+0x410) (be4a5ed) and polls getAttribute('amtr') for completion
+// (be4a867): 'amtr' is accepted, logged and retired at the next timer tick; no HUBP write (0029).
+// Every routed virtual logs its first call per framebuffer. No register is written anywhere here.
+namespace gopfb {
+
+struct Mode {
+	bool ok;
+	uint32_t w, h, rowBytes, depth, hz, htot, vtot;
+	uint64_t consolePhys, hubpMc, fbBaseMc;
+};
+Mode gMode;
+bool gOn, gRouted;
+constexpr IODisplayModeID ModeLit = 100, ModeOffline = 200;  // 100 = IOBootNDRV's kIOBootNDRVDisplayMode
+
+// Framebuffer index from its location ("0".."2"), cached: 'amtr' arrives on the accelerator's
+// thread with its locks held, where a registry lookup (getLocation) is better avoided.
+void *gFbPtr[4];
+int fbIndex(void *fb) {
+	for (int i = 0; i < 4; i++)
+		if (fb && gFbPtr[i] == fb)
+			return i;
+	auto l = fb ? static_cast<IOService *>(fb)->getLocation() : nullptr;
+	int i = l && l[0] >= '0' && l[0] <= '3' && !l[1] ? l[0] - '0' : -1;
+	if (i >= 0)
+		gFbPtr[i] = fb;
+	return i;
+}
+
+// First call of each routed virtual, per framebuffer 0..3: the boot log shows the real order.
+void first(int what, const char *name, void *fb, uint64_t a = 0, uint64_t b = 0) {
+	static volatile uint32_t seen[40];
+	int i = fbIndex(fb);
+	uint32_t bit = 1u << (i < 0 || i > 3 ? 4 : i);
+	if (what < 0 || what >= 40 || (seen[what] & bit))
+		return;
+	seen[what] |= bit;
+	LOG("gopfb: first %s on fb%d (%llx, %llx)", name, i, a, b);
+}
+
+// Read once, before the first open (stage4aOpen) and again lazily if that did not run. Only reads.
+void sample(bool measureHz) {
+	constexpr uint32_t D = 0x34C0, G0 = 0x1260;
+	PE_Video v {};
+	bool pe = IOService::getPlatform() && IOService::getPlatform()->getConsoleInfo(&v) == kIOReturnSuccess;
+	Mode m {};
+	if (pe) {
+		m.consolePhys = v.v_baseAddr & ~3UL;
+		m.w = static_cast<uint32_t>(v.v_width), m.h = static_cast<uint32_t>(v.v_height);
+		m.rowBytes = static_cast<uint32_t>(v.v_rowBytes), m.depth = static_cast<uint32_t>(v.v_depth);
+	}
+	if (mmioAvailable()) {
+		uint32_t vp = mmioRead(D + 0x5ea), pitch = mmioRead(D + 0x607) & 0x3fff;
+		m.hubpMc = (static_cast<uint64_t>(mmioRead(D + 0x60b) & 0xffff) << 32) | mmioRead(D + 0x60a);
+		m.fbBaseMc = static_cast<uint64_t>(mmioRead(G0 + 0x16fc) & 0xFFFFFF) << 24;
+		m.htot = (mmioRead(D + 0x1b2a) & 0x7fff) + 1, m.vtot = (mmioRead(D + 0x1b2f) & 0x7fff) + 1;
+		LOG("gopfb: console %s phys %llx %ux%u rowBytes %u depth %u; HUBP0 viewport %ux%u pitch %u px addr %llx; FB base %llx; OTG0 total %ux%u",
+		    pe ? "ok" : "MISSING", m.consolePhys, m.w, m.h, m.rowBytes, m.depth, vp & 0x3fff, (vp >> 16) & 0x3fff, pitch + 1,
+		    m.hubpMc, m.fbBaseMc, m.htot, m.vtot);
+		if (!pe && (vp & 0x3fff)) {  // no console: fall back to the scanout registers
+			m.w = vp & 0x3fff, m.h = (vp >> 16) & 0x3fff, m.rowBytes = (pitch + 1) * 4, m.depth = 32;
+		}
+		if (measureHz && (mmioRead(D + 0x1b41) & 1)) {
+			uint32_t f0 = mmioRead(D + 0x1b4c) & 0xffffff;  // OTG0_OTG_STATUS_FRAME_COUNT, 24 bits
+			IOSleep(500);
+			m.hz = (((mmioRead(D + 0x1b4c) & 0xffffff) - f0) & 0xffffff) * 2;
+		}
+	}
+	if (m.hz < 20 || m.hz > 240)
+		m.hz = 60;  // logged below; the VBL timer only paces callbacks
+	m.ok = m.w && m.h && m.rowBytes >= m.w * 4 && (m.depth == 32 || m.depth == 24);
+	gMode = m;
+	LOG("gopfb: mode %s: %ux%u rowBytes %u %u Hz%s", m.ok ? "inherited" : "NOT usable (enableController keeps refusing)", m.w, m.h,
+	    m.rowBytes, m.hz, measureHz ? "" : " (not measured)");
+}
+
+// --- interrupts: 'vbl ' and 'fstr' fire every tick, 'txni' once per accepted 'amtr' transaction.
+struct Irq {
+	void *fb;
+	IOSelect type;
+	void (*proc)(OSObject *, void *);
+	OSObject *target;
+	void *ref;
+	volatile bool used, on;
+};
+Irq gIrq[24];
+struct TxnSnap {
+	volatile bool ready, logged;
+	int fb;
+	uint64_t addr, txn[6];
+	uint32_t flip[16];
+};
+TxnSnap gTxnSnap[4];
+IOSimpleLock *gIrqLock;
+volatile UInt32 gTxnPending[4];
+volatile SInt32 gTxnSeen;
+volatile uint32_t gTicks;
+
+void tickThread(void *, wait_result_t) {
+	for (;;) {
+		IOSleep(gMode.hz ? 1000 / gMode.hz : 16);
+		gTicks++;
+		uint32_t pend[4];
+		for (int i = 0; i < 4; i++)
+			pend[i] = gTxnPending[i] && OSCompareAndSwap(1, 0, &gTxnPending[i]);
+		for (auto &q : gIrq) {
+			if (!q.used || !q.on || !q.proc)
+				continue;
+			int i = fbIndex(q.fb);
+			bool fire = q.type == 'vbl ' || q.type == 'fstr' || (q.type == 'txni' && i >= 0 && i < 4 && pend[i]);
+			if (fire)
+				q.proc(q.target, q.ref);
+		}
+		for (uint32_t k = 0; k < 4; k++) {
+			auto &x = gTxnSnap[k];
+			if (!x.ready || x.logged)
+				continue;
+			x.logged = true;
+			LOG("gopfb: amtr #%u fb%d txn %llx: %llx %llx %llx %llx %llx %llx", k + 1, x.fb, x.addr, x.txn[0], x.txn[1], x.txn[2],
+			    x.txn[3], x.txn[4], x.txn[5]);
+			LOG("gopfb: amtr #%u flip: %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x", k + 1, x.flip[0],
+			    x.flip[1], x.flip[2], x.flip[3], x.flip[4], x.flip[5], x.flip[6], x.flip[7], x.flip[8], x.flip[9], x.flip[10], x.flip[11],
+			    x.flip[12], x.flip[13], x.flip[14], x.flip[15]);
+		}
+		if (gTicks == 600 || gTicks % 36000 == 0)
+			LOG("gopfb: tick %u, amtr transactions seen %u", gTicks, gTxnSeen);
+	}
+}
+
+// --- the routed virtuals (signatures from the 15.8.1 AMDRadeonX6000_AmdRadeonFramebuffer symbols)
+mach_vm_address_t gfbOrgGetAttr, gfbOrgSetAttr;
+
+// WindowServer may open the stubs before stage4aOpen samples (boot of 25/11 14:41: three opens at
+// 44.87 s, before the kext's own): sample here once if needed, inside the first enableController.
+IOReturn enable() {
+	static bool sampled;
+	if (gOn && gRouted && !gMode.ok && !sampled) {
+		sampled = true;
+		sample(true);
+	}
+	return gOn && gRouted && gMode.ok ? kIOReturnSuccess : kIOReturnUnsupported;
+}
+
+IOItemCount getDisplayModeCount(void *fb) {
+	first(0, "getDisplayModeCount", fb);
+	return 1;
+}
+IOReturn getDisplayModes(void *fb, IODisplayModeID *ids) {
+	first(1, "getDisplayModes", fb);
+	if (!ids)
+		return kIOReturnBadArgument;
+	*ids = fbIndex(fb) == 0 ? ModeLit : ModeOffline;
+	return kIOReturnSuccess;
+}
+IOReturn getInformationForDisplayMode(void *fb, IODisplayModeID mode, IODisplayModeInformation *info) {
+	first(2, "getInformationForDisplayMode", fb, static_cast<uint32_t>(mode));
+	if (!info)
+		return kIOReturnBadArgument;
+	bzero(info, sizeof(*info));
+	if (mode == ModeOffline)
+		return kIOReturnSuccess;  // 0x0, flags 0
+	if (mode != ModeLit)
+		return kIOReturnBadArgument;
+	info->nominalWidth = gMode.w;
+	info->nominalHeight = gMode.h;
+	info->refreshRate = gMode.hz << 16;
+	info->maxDepthIndex = 0;
+	info->flags = kDisplayModeValidFlag | kDisplayModeSafeFlag | kDisplayModeDefaultFlag | kDisplayModeNativeFlag;
+	return kIOReturnSuccess;
+}
+UInt64 getPixelFormatsForDisplayMode(void *fb, IODisplayModeID, IOIndex) {
+	first(3, "getPixelFormatsForDisplayMode", fb);
+	return 0;  // deprecated; Apple's returns 0 too (c014af8)
+}
+const char *getPixelFormats(void *fb) {
+	first(4, "getPixelFormats", fb);
+	static const char formats[] = IO32BitDirectPixels "\0";
+	return formats;
+}
+IOReturn getPixelInformation(void *fb, IODisplayModeID mode, IOIndex depth, IOPixelAperture ap, IOPixelInformation *pi) {
+	first(5, "getPixelInformation", fb, static_cast<uint32_t>(mode), static_cast<uint32_t>(depth));
+	if (!pi || mode != ModeLit || depth != 0 || ap != kIOFBSystemAperture)
+		return kIOReturnUnsupportedMode;
+	bzero(pi, sizeof(*pi));
+	pi->bytesPerRow = gMode.rowBytes;
+	pi->bytesPerPlane = 0;
+	pi->bitsPerPixel = 32;
+	pi->pixelType = kIORGBDirectPixels;
+	pi->componentCount = 3;
+	pi->bitsPerComponent = 8;
+	pi->componentMasks[0] = 0x00ff0000, pi->componentMasks[1] = 0x0000ff00, pi->componentMasks[2] = 0x000000ff;
+	strlcpy(pi->pixelFormat, IO32BitDirectPixels, sizeof(pi->pixelFormat));
+	pi->flags = 0;
+	pi->activeWidth = gMode.w;
+	pi->activeHeight = gMode.h;
+	return kIOReturnSuccess;
+}
+IOReturn getCurrentDisplayMode(void *fb, IODisplayModeID *mode, IOIndex *depth) {
+	first(6, "getCurrentDisplayMode", fb);
+	if (fbIndex(fb) != 0)
+		return kIOReturnUnsupported;  // offline: initFB skips (IOFramebuffer.cpp:9694)
+	if (mode)
+		*mode = ModeLit;
+	if (depth)
+		*depth = 0;
+	return kIOReturnSuccess;
+}
+IOReturn getStartupDisplayMode(void *fb, IODisplayModeID *mode, IOIndex *depth) {
+	first(7, "getStartupDisplayMode", fb);
+	if (mode)
+		*mode = fbIndex(fb) == 0 ? ModeLit : ModeOffline;
+	if (depth)
+		*depth = 0;
+	return kIOReturnSuccess;
+}
+IOReturn setDisplayMode(void *fb, IODisplayModeID mode, IOIndex depth) {
+	first(8, "setDisplayMode", fb, static_cast<uint32_t>(mode), static_cast<uint32_t>(depth));
+	return (mode == ModeLit && depth == 0) || mode == ModeOffline ? kIOReturnSuccess : kIOReturnUnsupportedMode;
+}
+IOReturn setStartupDisplayMode(void *fb, IODisplayModeID mode, IOIndex) {
+	first(9, "setStartupDisplayMode", fb, static_cast<uint32_t>(mode));
+	return kIOReturnSuccess;  // nothing persisted
+}
+IOReturn getTimingInfoForDisplayMode(void *fb, IODisplayModeID mode, IOTimingInformation *t) {
+	first(10, "getTimingInfoForDisplayMode", fb, static_cast<uint32_t>(mode));
+	if (!t)
+		return kIOReturnBadArgument;
+	if (mode == ModeOffline) {
+		t->appleTimingID = kIOTimingIDApple_0x0_0hz_Offline;  // updateOnline's offline mode (:7815)
+		t->flags = 0;
+		return kIOReturnSuccess;
+	}
+	if (mode != ModeLit)
+		return kIOReturnBadArgument;
+	t->appleTimingID = 0;  // IOBootNDRV: csTimingData 0, no detailed timing (IONDRVFramebuffer.cpp:2432-2441, 4582)
+	t->flags = 0;
+	return kIOReturnSuccess;
+}
+IOReturn validateDetailedTiming(void *fb, void *, UInt64) {
+	first(11, "validateDetailedTiming", fb);
+	return kIOReturnUnsupported;
+}
+IOReturn setDetailedTimings(void *fb, OSArray *) {
+	first(12, "setDetailedTimings", fb);
+	return kIOReturnUnsupported;
+}
+IOReturn connectFlags(void *fb, IOIndex, IODisplayModeID mode, IOOptionBits *flags) {
+	first(13, "connectFlags", fb, static_cast<uint32_t>(mode));
+	if (flags)
+		*flags = mode == ModeLit ? kDisplayModeValidFlag | kDisplayModeSafeFlag : 0;
+	return kIOReturnSuccess;
+}
+IODeviceMemory *getApertureRange(void *fb, IOPixelAperture ap) {
+	first(14, "getApertureRange", fb, static_cast<uint32_t>(ap));
+	if (ap != kIOFBSystemAperture || fbIndex(fb) != 0 || !gMode.ok)
+		return nullptr;
+	// IOBootNDRV: the console's physical address inside one of the device's memory ranges.
+	auto dev = OSDynamicCast(IOService, static_cast<IOService *>(fb)->getProvider());
+	for (int up = 0; dev && up < 4; up++, dev = OSDynamicCast(IOService, dev->getProvider())) {
+		for (unsigned i = 0; i < dev->getDeviceMemoryCount(); i++) {
+			auto mem = dev->getDeviceMemoryWithIndex(i);
+			uint64_t pa = mem ? mem->getPhysicalAddress() : 0, len = mem ? mem->getLength() : 0;
+			uint64_t bytes = (static_cast<uint64_t>(gMode.rowBytes) * gMode.h + PAGE_MASK) & ~static_cast<uint64_t>(PAGE_MASK);
+			if (!mem || gMode.consolePhys < pa || gMode.consolePhys + bytes > pa + len)
+				continue;
+			static bool logged;
+			if (!logged) {
+				logged = true;
+				LOG("gopfb: aperture = %s memory %u (%llx + %llx) offset %llx length %llx; HUBP0 offset from FB base %llx",
+				    dev->getName(), i, pa, len, gMode.consolePhys - pa, bytes, gMode.hubpMc - gMode.fbBaseMc);
+			}
+			return IODeviceMemory::withSubRange(mem, gMode.consolePhys - pa, bytes);
+		}
+	}
+	LOG("gopfb: console %llx is in no device memory range of the framebuffer's providers", gMode.consolePhys);
+	return nullptr;
+}
+IOReturn getAttributeForConnection(void *fb, IOIndex conn, IOSelect sel, uintptr_t *value) {
+	first(15, "getAttributeForConnection", fb, sel);
+	static IOSelect logged[32];
+	static uint32_t n;
+	bool known = false;
+	for (uint32_t i = 0; i < n; i++)
+		known |= logged[i] == sel;
+	if (!known && n < 32) {
+		logged[n++] = sel;
+		LOG("gopfb: getAttributeForConnection(fb%d, %d, '%c%c%c%c')", fbIndex(fb), static_cast<int>(conn), (sel >> 24) & 0xff,
+		    (sel >> 16) & 0xff, (sel >> 8) & 0xff, sel & 0xff);
+	}
+	bool lit = fbIndex(fb) == 0;
+	switch (sel) {
+		case kConnectionEnable:
+		case kConnectionCheckEnable:
+			if (value)
+				*value = lit;  // offline must be SUCCESS with 0 (IOFramebuffer.cpp:7781)
+			return kIOReturnSuccess;
+		case kConnectionFlags:
+			if (value)
+				*value = lit ? kIOConnectionBuiltIn : 0;
+			return kIOReturnSuccess;
+		default:
+			return kIOReturnUnsupported;  // 'lddc', 'hddc', 'parm', ...: no DDC, no parameters
+	}
+}
+IOReturn setAttributeForConnection(void *fb, IOIndex, IOSelect sel, uintptr_t value) {
+	first(16, "setAttributeForConnection", fb, sel, value);
+	return kIOReturnSuccess;  // power, probe, sync: nothing to do on an inherited mode
+}
+bool hasDDCConnect(void *fb, IOIndex) {
+	first(17, "hasDDCConnect", fb);
+	return false;
+}
+IOReturn getDDCBlock(void *fb, IOIndex, UInt32, IOSelect, IOOptionBits, UInt8 *, IOByteCount *) {
+	first(18, "getDDCBlock", fb);
+	return kIOReturnUnsupported;
+}
+IOReturn getAppleSense(void *fb, IOIndex, UInt32 *, UInt32 *, UInt32 *, UInt32 *) {
+	first(19, "getAppleSense", fb);
+	return kIOReturnUnsupported;
+}
+IOReturn setGammaTable(void *fb, UInt32, UInt32, UInt32, void *, bool) {
+	first(20, "setGammaTable", fb);
+	return kIOReturnSuccess;
+}
+IOReturn setCursorImage(void *fb, void *) {
+	first(21, "setCursorImage", fb);
+	return kIOReturnUnsupported;
+}
+IOReturn setCursorState(void *fb, SInt32, SInt32, bool) {
+	first(22, "setCursorState", fb);
+	return kIOReturnUnsupported;
+}
+IOReturn getAttribute(void *fb, IOSelect sel, uintptr_t *value) {
+	first(23, "getAttribute", fb, sel);
+	if (sel == 'amtr')
+		return gTxnPending[fbIndex(fb) & 3] ? kIOReturnNotReady : kIOReturnSuccess;  // *value untouched, as Apple's
+	static IOSelect logged[32];
+	static uint32_t n;
+	bool known = false;
+	for (uint32_t i = 0; i < n; i++)
+		known |= logged[i] == sel;
+	if (!known && n < 32) {
+		logged[n++] = sel;
+		LOG("gopfb: getAttribute(fb%d, '%c%c%c%c') -> unsupported", fbIndex(fb), (sel >> 24) & 0xff, (sel >> 16) & 0xff,
+		    (sel >> 8) & 0xff, sel & 0xff);
+	}
+	return kIOReturnUnsupported;  // 'crsr' (no hardware cursor), 'vclt', ...
+}
+IOReturn setAttribute(void *fb, IOSelect sel, uintptr_t value) {
+	first(24, "setAttribute", fb, sel, value);
+	int i = fbIndex(fb);
+	if (sel == 'amtr') {
+		if (!value)
+			return kIOReturnBadArgument;
+		uint32_t n = OSIncrementAtomic(&gTxnSeen) + 1;
+		auto t = reinterpret_cast<const uint64_t *>(value);
+		if (n <= 4) {  // pipe+0x410: +0 flags (bit 0: +0x10 valid), +8 flag word, +0x10 flip state (be49dd2-be49e3f)
+			auto &snap = gTxnSnap[n - 1];  // copied here, printed by the tick thread (no log under the caller's locks)
+			memcpy(snap.txn, t, sizeof(snap.txn));
+			snap.fb = i, snap.addr = value;
+			if ((t[0] & 1) && t[2] >= 0xffffff8000000000ULL)
+				memcpy(snap.flip, reinterpret_cast<const void *>(t[2]), sizeof(snap.flip));
+			snap.ready = true;
+		}
+		if (i >= 0 && i < 4)
+			gTxnPending[i] = 1;  // retired by the next tick ('txni')
+		return kIOReturnSuccess;
+	}
+	static IOSelect logged[32];
+	static uint32_t n;
+	bool known = false;
+	for (uint32_t k = 0; k < n; k++)
+		known |= logged[k] == sel;
+	if (!known && n < 32) {
+		logged[n++] = sel;
+		LOG("gopfb: setAttribute(fb%d, '%c%c%c%c', %lx) -> success, nothing done", i, (sel >> 24) & 0xff, (sel >> 16) & 0xff,
+		    (sel >> 8) & 0xff, sel & 0xff, value);
+	}
+	return kIOReturnSuccess;  // power ('pwrs', 'dpow', 'spwr'), 'wsrv', ...: no hardware behind an inherited mode
+}
+IOReturn registerForInterruptType(void *fb, IOSelect type, void (*proc)(OSObject *, void *), OSObject *target, void *ref,
+                                  void **interruptRef) {
+	first(25, "registerForInterruptType", fb, type);
+	LOG("gopfb: registerForInterruptType(fb%d, '%c%c%c%c')", fbIndex(fb), (type >> 24) & 0xff, (type >> 16) & 0xff,
+	    (type >> 8) & 0xff, type & 0xff);
+	if (type != 'vbl ' && type != 'fstr' && type != 'txni')
+		return kIOReturnUnsupported;  // 'dci ', 'dpir', 'hdci': no hot plug on an inherited mode
+	IOSimpleLockLock(gIrqLock);
+	for (auto &q : gIrq) {
+		if (q.used)
+			continue;
+		q.fb = fb, q.type = type, q.proc = proc, q.target = target, q.ref = ref, q.on = true;
+		q.used = true;
+		IOSimpleLockUnlock(gIrqLock);
+		if (interruptRef)
+			*interruptRef = &q;
+		return kIOReturnSuccess;
+	}
+	IOSimpleLockUnlock(gIrqLock);
+	return kIOReturnNoResources;
+}
+IOReturn unregisterInterrupt(void *fb, void *ref) {
+	first(26, "unregisterInterrupt", fb);
+	auto q = static_cast<Irq *>(ref);
+	if (q < gIrq || q >= gIrq + arrsize(gIrq))
+		return kIOReturnBadArgument;
+	q->on = false;
+	q->used = false;
+	return kIOReturnSuccess;
+}
+IOReturn setInterruptState(void *fb, void *ref, UInt32 state) {
+	first(27, "setInterruptState", fb, state);
+	auto q = static_cast<Irq *>(ref);
+	if (q < gIrq || q >= gIrq + arrsize(gIrq) || !q->used)
+		return kIOReturnBadArgument;
+	q->on = state != 0;
+	return kIOReturnSuccess;
+}
