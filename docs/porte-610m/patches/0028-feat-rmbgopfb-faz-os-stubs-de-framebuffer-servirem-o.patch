+// rmbstage=3 -rmbfbstubs -rmbgopfb: route the stub virtuals. Without the argument nothing is routed.
+void displayRouteGopFb(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+	using namespace gopfb;
+	gOn = checkKernelArgument("-rmbgopfb");
+	if (!gOn)
+		return;
+	gIrqLock = IOSimpleLockAlloc();
+#define FBSYM(s) "__ZN35AMDRadeonX6000_AmdRadeonFramebuffer" s
+	KernelPatcher::RouteRequest reqs[] {
+		{FBSYM("19getDisplayModeCountEv"), getDisplayModeCount},
+		{FBSYM("15getDisplayModesEPi"), getDisplayModes},
+		{FBSYM("28getInformationForDisplayModeEiP24IODisplayModeInformation"), getInformationForDisplayMode},
+		{FBSYM("29getPixelFormatsForDisplayModeEii"), getPixelFormatsForDisplayMode},
+		{FBSYM("15getPixelFormatsEv"), getPixelFormats},
+		{FBSYM("19getPixelInformationEiiiP18IOPixelInformation"), getPixelInformation},
+		{FBSYM("21getCurrentDisplayModeEPiS0_"), getCurrentDisplayMode},
+		{FBSYM("21getStartupDisplayModeEPiS0_"), getStartupDisplayMode},
+		{FBSYM("14setDisplayModeEii"), setDisplayMode},
+		{FBSYM("21setStartupDisplayModeEii"), setStartupDisplayMode},
+		{FBSYM("27getTimingInfoForDisplayModeEiP19IOTimingInformation"), getTimingInfoForDisplayMode},
+		{FBSYM("22validateDetailedTimingEPvy"), validateDetailedTiming},
+		{FBSYM("18setDetailedTimingsEP7OSArray"), setDetailedTimings},
+		{FBSYM("12connectFlagsEiiPj"), connectFlags},
+		{FBSYM("16getApertureRangeEi"), getApertureRange},
+		{FBSYM("25getAttributeForConnectionEijPm"), getAttributeForConnection},
+		{FBSYM("25setAttributeForConnectionEijm"), setAttributeForConnection},
+		{FBSYM("13hasDDCConnectEi"), hasDDCConnect},
+		{FBSYM("11getDDCBlockEijjjPhPy"), getDDCBlock},
+		{FBSYM("13getAppleSenseEiPjS0_S0_S0_"), getAppleSense},
+		{FBSYM("13setGammaTableEjjjPvb"), setGammaTable},
+		{FBSYM("14setCursorImageEPv"), setCursorImage},
+		{FBSYM("14setCursorStateEiib"), setCursorState},
+		{FBSYM("12getAttributeEjPm"), getAttribute, gfbOrgGetAttr},
+		{FBSYM("12setAttributeEjm"), setAttribute, gfbOrgSetAttr},
+		{FBSYM("24registerForInterruptTypeEjPFvP8OSObjectPvES1_S2_PS2_"), registerForInterruptType},
+		{FBSYM("19unregisterInterruptEPv"), unregisterInterrupt},
+		{FBSYM("17setInterruptStateEPvj"), setInterruptState},
+	};
+#undef FBSYM
+	size_t routed = 0;
+	for (auto &r : reqs) {
+		if (patcher.routeMultiple(index, &r, 1, address, size))
+			routed++;
+		else
+			LOG("gopfb: failed to route %s (err %d)", r.symbol, patcher.getError());
+		patcher.clearError();
+	}
+	gRouted = routed == arrsize(reqs) && gIrqLock;
+	LOG("gopfb: %zu of %zu framebuffer virtuals routed; enableController will %s", routed, arrsize(reqs),
+	    gRouted ? "return success once the inherited mode is read" : "keep refusing (not every route is in place)");
+	thread_t t;
+	if (gRouted && kernel_thread_start(tickThread, nullptr, &t) == KERN_SUCCESS)
+		thread_deallocate(t);
+}
