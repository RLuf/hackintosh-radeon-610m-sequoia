@@ -1114,6 +1121,34 @@ static uint64_t wrap_vm_clean_primary_page_table(uint64_t vm, uint64_t b, uint64
 	return r;
 }
 
+// (e) patch 0021. The kext presents GC 10.3.7 to HWLibs as 10.3.3, so HWLibs runs
+// _vm_10_3_3_hw_init, whose last step is _gc_10_3_1_initialize_utcl2_bypass_groups: it reads the
+// shader-array disable bits (CC_GC_SA_UNIT_DISABLE | GC_USER_SA_UNIT_DISABLE, bits 9:8), turns each
+// disabled array into a pair of bits and writes GCUTCL2_HARVEST_BYPASS_GROUPS. That is Linux's
+// gfxhub_v2_1_utcl2_harvest, which does it ONLY for GC 10.3.1 and 10.3.3 (gfxhub_v2_1.c:544-582);
+// for 10.3.7 it programs nothing. Measured on the 610M (boot of 24/11 19:03, patch 0020): with the
+// GART clean no longer using CP DMA the command processor stays idle through all 11 LOAD_IP_FW,
+// and the moment AUTOLOAD_RLC runs CP_STAT becomes 80404000 with UTCL2IU_BUSY again: whatever goes
+// through the UTCL2 never gets an answer. Do what Linux does for this chip: leave the bypass
+// groups alone. -rmbutcl2harvest: let HWLibs program them as for the 680M.
+static mach_vm_address_t org_gc_10_3_1_initialize_utcl2_bypass_groups;
+static uint64_t wrap_gc_10_3_1_initialize_utcl2_bypass_groups(uint64_t a, uint64_t b, uint64_t c, uint64_t d, uint64_t e, uint64_t f) {
+	constexpr uint32_t G0 = 0x1260;
+	bool can = mmioAvailable();
+	uint32_t efuse = can ? mmioRead(G0 + 0x0fe9) : 0, user = can ? mmioRead(G0 + 0x0fea) : 0;
+	uint32_t yc = can ? mmioRead(G0 + 0x16f8) : 0, gen = can ? mmioRead(G0 + 0x16fa) : 0;
+	uint32_t dis = ((efuse | user) >> 8) & 3, want = (dis & 1 ? 3u : 0u) | (dis & 2 ? 0xcu : 0u);
+	if (gcHwVersion() == 0xa0307 && !checkKernelArgument("-rmbutcl2harvest")) {
+		LOG("gc: 610M: UTCL2 harvest bypass groups NOT programmed (Linux does it only for GC 10.3.1/10.3.3); CC_SA_DIS %x USER_SA_DIS %x -> HWLibs would write %x; register now yc(16f8) %x gen(16fa) %x",
+		    efuse, user, want, yc, gen);
+		return 0;
+	}
+	auto r = reinterpret_cast<Fn6>(org_gc_10_3_1_initialize_utcl2_bypass_groups)(a, b, c, d, e, f);
+	LOG("gc: utcl2 bypass groups programmed by HWLibs: CC_SA_DIS %x USER_SA_DIS %x (expected value %x); yc(16f8) %x -> %x, gen(16fa) %x -> %x",
+	    efuse, user, want, yc, can ? mmioRead(G0 + 0x16f8) : 0, gen, can ? mmioRead(G0 + 0x16fa) : 0);
+	return r;
+}
+
 static void processHWLibs(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
 	bool s2 = rmbStage() == 2, s3 = rmbStage() == 3;
 	KernelPatcher::RouteRequest requests[] {
@@ -1206,6 +1241,8 @@ static void processHWLibs(KernelPatcher &patcher, size_t index, mach_vm_address_
 			{"_gc_check_grbm_cam_remap_10_3", wrap_gc_check_grbm_cam_remap_10_3, org_gc_check_grbm_cam_remap_10_3},
 			{"_gc_golden_settings_execution", wrap_gc_golden_settings_execution, org_gc_golden_settings_execution},
 			{"_vm_clean_primary_page_table", wrap_vm_clean_primary_page_table, org_vm_clean_primary_page_table},
+			{"_gc_10_3_1_initialize_utcl2_bypass_groups", wrap_gc_10_3_1_initialize_utcl2_bypass_groups,
+			 org_gc_10_3_1_initialize_utcl2_bypass_groups},
 		};
 		unsigned routed = 0;
 		for (auto &r : diag) {
@@ -1215,7 +1252,7 @@ static void processHWLibs(KernelPatcher &patcher, size_t index, mach_vm_address_
 				LOG("failed to route %s (err %d)", r.symbol, patcher.getError());
 			patcher.clearError();
 		}
-		LOG("stage 3: %u of 8 stage-3 hooks installed (3 measurement, 5 fixes: asd load, asd unload, cam, golden, gart clean)", routed);
+		LOG("stage 3: %u of 9 stage-3 hooks installed (3 measurement, 6 fixes: asd load, asd unload, cam, golden, gart clean, utcl2 harvest)", routed);
 		LOG("stage 3: ttl_hw_init runs only if the preflight passes; wake POST hooks not installed");
 	}
 	LOG("HWLibs hooks installed");
