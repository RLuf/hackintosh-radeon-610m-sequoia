From 718c7dcde4a3e6b3cc1d769a4c65176bd6c95dea Mon Sep 17 00:00:00 2001
From: fzmac <noreply@example.invalid>
Date: Tue, 24 Nov 2026 18:07:14 -0800
Subject: [PATCH 18/48] fix: espera tardia do autoload usa a condicao do Linux
 e dorme em vez de travar a CPU

- o laco de 400 ms depois de _gc_check_ucode_loaded_10_1 passa a exigir
  CP_STAT == 0 E BOOTLOAD_COMPLETE (gfx_v10_0_wait_for_rlc_autoload_complete),
  em vez de so o bit 31; usa IOSleep(10) no lugar de IODelay(10000);
  registra em que milissegundo cada condicao valeu pela primeira vez.
- a linha de diagnostico le RLC_GPM_STAT (0x4e6e) e RLC_SRM_STAT (0x4c9b);
  antes lia 0x4c05 e 0x4c06, que nao sao esses registradores.
- TRACE_HOOK imprime tambem os 32 bits baixos do retorno, que o kernel nao
  redige como <ptr>.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KLHgSo88Xro5AsvDqwXSnr
---
 src/RembrandtGfx/kern_start.cpp | 27 +++++++++++++++++++--------
 1 file changed, 19 insertions(+), 8 deletions(-)

diff --git a/src/RembrandtGfx/kern_start.cpp b/src/RembrandtGfx/kern_start.cpp
index 8d45767..4e4b7bf 100644
--- a/src/RembrandtGfx/kern_start.cpp
+++ b/src/RembrandtGfx/kern_start.cpp
@@ -40,7 +40,7 @@ static auto &kextHWLibs = kexts[0];
 	static uint64_t wrap_##name(uint64_t a, uint64_t b, uint64_t c, uint64_t d, uint64_t e, uint64_t f) { \
 		LOG(">> " #name "(%llx, %llx)", a, b);                                              \
 		auto r = reinterpret_cast<Fn6>(org_##name)(a, b, c, d, e, f);                       \
-		LOG("<< " #name " = %llx", r);                                                       \
+		LOG("<< " #name " = %llx (lo32 %x)", r, static_cast<uint32_t>(r));                   \
 		return r;                                                                            \
 	}
 
@@ -848,19 +848,30 @@ static uint64_t wrap_gc_check_ucode_loaded_10_1(uint64_t gc, uint64_t b, uint64_
 		return 0;
 	}
 	if ((r & 0xFFFFFFFF) != 0) {
-		for (int ms = 0; ms < 400 && ((bootload & 0x80000000u) == 0 || bootload == 0xFFFFFFFFu); ms += 10) {
-			IODelay(10000);
+		// Late completion: Apple waited 50 ms. Keep looking for up to 400 ms more, with the condition
+		// Linux uses (gfx_v10_0_wait_for_rlc_autoload_complete): CP_STAT == 0 AND BOOTLOAD_COMPLETE.
+		// Sleeps instead of busy-waiting, and logs when each of the two conditions first holds.
+		auto done = [&]() { return cpStat == 0 && (bootload & 0x80000000u) != 0 && bootload != 0xFFFFFFFFu; };
+		int cpIdleAt = cpStat == 0 ? 0 : -1, bootAt = (bootload & 0x80000000u) && bootload != 0xFFFFFFFFu ? 0 : -1;
+		for (int ms = 10; ms <= 400 && !done(); ms += 10) {
+			IOSleep(10);
 			bootload = mmioRead(0xA000 + 0x4e8d);
 			rlcStat = mmioRead(0xA000 + 0x4c04);
 			cpStat = mmioRead(0x1260 + 0x0f40);
+			if (cpIdleAt < 0 && cpStat == 0)
+				cpIdleAt = ms;
+			if (bootAt < 0 && (bootload & 0x80000000u) && bootload != 0xFFFFFFFFu)
+				bootAt = ms;
 		}
-		if ((bootload & 0x80000000u) != 0 && bootload != 0xFFFFFFFFu) {
-			LOG("gc_check_ucode_loaded: BOOTLOAD_COMPLETE=1 (bootload=%x rlc_stat=%x cp_stat=%x) -> returning 0",
-			    bootload, rlcStat, cpStat);
+		LOG("gc_check_ucode_loaded: late wait: CP_STAT==0 first at %d ms, BOOTLOAD_COMPLETE first at %d ms (-1 = never)",
+		    cpIdleAt, bootAt);
+		if (done()) {
+			LOG("gc_check_ucode_loaded: autoload complete late (bootload=%x rlc_stat=%x cp_stat=0) -> returning 0",
+			    bootload, rlcStat);
 			return 0;
 		}
-		LOG("gc_check_ucode_loaded: diag +400ms: BOOTLOAD=%x RLC_STAT=%x GPM=%x SRM=%x SCHED=%x GRBM2=%x CPC=%x CPF=%x MEC_CNTL=%x ME_CNTL=%x MEC1_IP=%x",
-		    bootload, rlcStat, mmioRead(0xA000 + 0x4c05), mmioRead(0xA000 + 0x4c06), mmioRead(0xA000 + 0x4ca1),
+		LOG("gc_check_ucode_loaded: diag +400ms: BOOTLOAD=%x RLC_STAT=%x RLC_GPM_STAT=%x RLC_SRM_STAT=%x SCHED=%x GRBM2=%x CPC=%x CPF=%x MEC_CNTL=%x ME_CNTL=%x MEC1_IP=%x",
+		    bootload, rlcStat, mmioRead(0xA000 + 0x4e6e), mmioRead(0xA000 + 0x4c9b), mmioRead(0xA000 + 0x4ca1),
 		    mmioRead(0x1260 + 0x0da2), mmioRead(0x1260 + 0x0e24), mmioRead(0x1260 + 0x0e27),
 		    mmioRead(0x1260 + 0x0f55), mmioRead(0x1260 + 0x0f56), mmioRead(0x1260 + 0x0f48));
 		LOG("gc_check_ucode_loaded: gcvm: FB=%x-%x off=%x ctx0=%x fault=%x addr=%x_%08x; psp 64=%08x 81=%08x",
