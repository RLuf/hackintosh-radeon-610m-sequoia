+// Patch 0022. SETUP_TMR as Linux sends it for PSP 13.0.8.
+// HWLibs' _psp_tmr_load fills only the GPU address and the size, and _psp_cmd_km_buf_prep copies
+// just those three dwords into the command buffer (cmd 5: +0x1c, +0x20, +0x24), which
+// _psp_cmd_km_allocate_buf has zeroed. So tmr_flags and system_phy_addr reach the TOS as 0.
+// Linux v6.12 psp_prep_tmr_cmd_buf (amdgpu_psp.c:762-784) sets, for every ASIC and so for MP0
+// 13.0.8 (boot_time_tmr = false, :213-224): bitfield.virt_phy_addr = 1 and system_phy_addr =
+// amdgpu_gmc_vram_pa = mc - vram_start + (GCMC_VM_FB_OFFSET << 24). On a UMA chip the TMR lives in
+// system RAM, and the physical address is the only one that needs no GPU-side translation.
+// Applied only on the 610M, only when the TMR lies inside the FB range the chip reports and the
+// three fields are still 0. -rmbtmrvirtonly: send Apple's command untouched.
+// Command buffer layout (Linux psp_gfx_if.h, struct psp_gfx_cmd_resp): dword 2 = cmd_id, 7/8 =
+// buf_phy_addr lo/hi, 9 = buf_size, 10 = tmr_flags (bit 1 = virt_phy_addr), 11/12 = system_phy_addr.
+mach_vm_address_t orgPspCmdKmBufPrep;
+uint64_t wrapPspCmdKmBufPrep(uint64_t psp, uint64_t inBuf, uint64_t handle, uint64_t d, uint64_t e, uint64_t f) {
+	auto r = reinterpret_cast<Fn6>(orgPspCmdKmBufPrep)(psp, inBuf, handle, d, e, f);
+	if ((r & 0xFFFFFFFF) || !psp || !inBuf || !handle || *reinterpret_cast<const uint32_t *>(inBuf) != 5)
+		return r;
+	uint32_t slot = *reinterpret_cast<const uint32_t *>(handle);
+	if (slot > 0xf || !mmioAvailable())
+		return r;
+	auto buf = *reinterpret_cast<uint32_t **>(psp + 0x760 + slot * 0x38ull);
+	if (!buf || buf[2] != 5)
+		return r;
+	constexpr uint32_t G0 = 0x1260;
+	uint64_t mc = (static_cast<uint64_t>(buf[8]) << 32) | buf[7];
+	uint64_t tmrSize = buf[9];
+	uint64_t fbBase = static_cast<uint64_t>(mmioRead(G0 + 0x16fc) & 0xFFFFFF) << 24;
+	uint64_t fbTop = (static_cast<uint64_t>(mmioRead(G0 + 0x16fd) & 0xFFFFFF) << 24) | 0xFFFFFF;
+	uint64_t fbOff = static_cast<uint64_t>(mmioRead(G0 + 0x16e7) & 0xFFFFFF) << 24;
+	bool inFb = tmrSize && fbTop > fbBase && mc >= fbBase && mc + tmrSize - 1 <= fbTop;
+	bool untouched = !buf[10] && !buf[11] && !buf[12];
+	uint64_t pa = mc - fbBase + fbOff;
+	// The header asks for a 4 KB aligned address. This hook also runs for _psp_cmd_km_submit_rt
+	// (the retry path), which prepares the same command again.
+	bool apply = gcHwVersion() == 0xa0307 && inFb && fbOff && untouched && !(pa & 0xfff) &&
+	             !checkKernelArgument("-rmbtmrvirtonly");
+	LOG("psp-km: SETUP_TMR as HWLibs built it: mc %x_%08x size %#x flags %x sys_pa %x_%08x; mc %% size %#llx; FB %x_%08x-%x_%08x offset %x_%08x",
+	    buf[8], buf[7], buf[9], buf[10], buf[12], buf[11], tmrSize ? mc % tmrSize : 0,
+	    static_cast<uint32_t>(fbBase >> 32), static_cast<uint32_t>(fbBase), static_cast<uint32_t>(fbTop >> 32),
+	    static_cast<uint32_t>(fbTop), static_cast<uint32_t>(fbOff >> 32), static_cast<uint32_t>(fbOff));
+	if (apply) {
+		buf[10] = 2;  // bitfield.virt_phy_addr (bit 1; bit 0 is sriov_enabled)
+		buf[11] = static_cast<uint32_t>(pa);
+		buf[12] = static_cast<uint32_t>(pa >> 32);
+		LOG("psp-km: SETUP_TMR 610M: sent as Linux does: virt_phy_addr=1 sys_pa %x_%08x", buf[12], buf[11]);
+	} else {
+		LOG("psp-km: SETUP_TMR left as HWLibs built it (610M %d, inside FB %d, FB offset set %d, fields zero %d, -rmbtmrvirtonly %d)",
+		    gcHwVersion() == 0xa0307, inFb, fbOff != 0, untouched, checkKernelArgument("-rmbtmrvirtonly"));
+	}
+	return r;
+}
