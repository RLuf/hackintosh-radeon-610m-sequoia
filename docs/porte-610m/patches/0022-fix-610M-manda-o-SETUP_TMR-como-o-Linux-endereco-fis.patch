 mach_vm_address_t orgPspCmdKmSubmit;
 uint64_t wrapPspCmdKmSubmit(uint64_t psp, uint64_t inBuf, uint64_t outResp, uint64_t d, uint64_t e, uint64_t f) {
 	uint32_t cmd = inBuf ? *reinterpret_cast<const uint32_t *>(inBuf) : 0;
 	uint32_t fwType = (inBuf && cmd == 6) ? *reinterpret_cast<const uint32_t *>(inBuf + 0x10) : 0;
+	// Where each firmware sits (GPU address) and its size: fields +4, +8, +0xc of the request.
+	uint32_t fwLo = (inBuf && cmd == 6) ? *reinterpret_cast<const uint32_t *>(inBuf + 0x4) : 0;
+	uint32_t fwHi = (inBuf && cmd == 6) ? *reinterpret_cast<const uint32_t *>(inBuf + 0x8) : 0;
+	uint32_t fwSize = (inBuf && cmd == 6) ? *reinterpret_cast<const uint32_t *>(inBuf + 0xc) : 0;
 	auto r = reinterpret_cast<Fn6>(orgPspCmdKmSubmit)(psp, inBuf, outResp, d, e, f);
 	// The submit's return is 0 even when the TOS refuses the command; the TOS answer is the first
 	// dword of the response (status, then session id at +4: _psp_asd_load reads the id from there).
@@ -248,8 +304,8 @@ uint64_t wrapPspCmdKmSubmit(uint64_t psp, uint64_t inBuf, uint64_t outResp, uint
 			    r & 0xFFFFFFFF, tos, mmioRead(0xA000 + 0x4c00), mmioRead(0xA000 + 0x4c04), mmioRead(0xA000 + 0x4e8d),
 			    mmioRead(0x1260 + 0x0f40), mmioRead(0x1260 + 0x0da4));
 		} else if (cmd == 6) {
-			LOG("psp-km: LOAD_IP_FW type=%u ret=%llx tos=%x; CP_STAT=%x GRBM=%x", fwType, r & 0xFFFFFFFF, tos,
-			    mmioRead(0x1260 + 0x0f40), mmioRead(0x1260 + 0x0da4));
+			LOG("psp-km: LOAD_IP_FW type=%u ret=%llx tos=%x; CP_STAT=%x GRBM=%x; fw mc %x_%08x size %#x", fwType,
+			    r & 0xFFFFFFFF, tos, mmioRead(0x1260 + 0x0f40), mmioRead(0x1260 + 0x0da4), fwHi, fwLo, fwSize);
 		} else {
 			LOG("psp-km: cmd=%#x ret=%llx tos=%x; CP_STAT=%x GRBM=%x", cmd, r & 0xFFFFFFFF, tos,
 			    mmioRead(0x1260 + 0x0f40), mmioRead(0x1260 + 0x0da4));
@@ -331,6 +387,16 @@ void firmwareRoute(KernelPatcher &patcher, size_t index, mach_vm_address_t addre
 	if (!gFwHooksOk)
 		LOG("fw: failed to route PSP firmware hooks (err %d)", patcher.getError());
 	patcher.clearError();
+	// Patch 0022: routed on its own, so a failure here leaves the three hooks above in place.
+	if (rmbStage() == 3) {
+		KernelPatcher::RouteRequest tmrReq[] {
+			{"_psp_cmd_km_buf_prep", wrapPspCmdKmBufPrep, orgPspCmdKmBufPrep},
+		};
+		bool tmrOk = patcher.routeMultiple(index, tmrReq, 1, address, size);
+		LOG("fw: SETUP_TMR hook (_psp_cmd_km_buf_prep) %s; tmr %s", tmrOk ? "installed" : "NOT installed",
+		    checkKernelArgument("-rmbtmrvirtonly") ? "virtual only (-rmbtmrvirtonly)" : "virtual + physical, as Linux");
+		patcher.clearError();
+	}
 
 	for (auto &s : subs) {
 		auto desc = patcher.solveSymbol<uint8_t *>(index, s.symbol, address, size);
